@using Horizonte
@inject IHContext Context
<RadzenCard style="width: 100%" >
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Gmaps Config"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
            <RadzenButton Text="Grabar" Variant="Variant.Outlined" Icon="save" Size="ButtonSize.Small"
                          Click="Update"></RadzenButton>
        </div>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical">

        <div>
            <RadzenText Text="API Key"/>
            <CredentialSelector @bind-value="_gmapsConfig.ApiKey"/>
        </div>

    </RadzenStack>
    <br/>
</RadzenCard>

@code {
    GmapsConfig _gmapsConfig = new();

    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    private void Get()
    {
        _gmapsConfig = Context.Get<GmapsConfig>() ?? new GmapsConfig();
    }

    private void Update()
    {
        Context.Update(_gmapsConfig);
    }

}