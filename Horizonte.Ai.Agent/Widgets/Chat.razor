@using System.Text.Json
@using Horizonte
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.Extensions.Logging
@using Microsoft.SemanticKernel
@inject IHGesCom GesCom
@inject ILogger Logger
@inject IHContext Context

<RadzenStack style="width: 100%" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.Center">

   <RadzenStack style="width: 100%" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                align-items="center">
      <RadzenTextBox Style="width: 100%" @bind-Value="@_prompt"></RadzenTextBox>
      <RadzenButton IsBusy="@_busy" Icon="send" Click="Send"></RadzenButton>
      <RadzenButton Click="ClearChat" Icon="tab_close"></RadzenButton>
   </RadzenStack>

   <RadzenListBox style="width: 100%" TValue="ChatElement" @bind-Value=@_selectedChatElement Data=@_chatlist>
      <Template>
         <RadzenCard style="width: 100%">
            <RadzenStack AlignItems="AlignItems.Center"
                         JustifyContent="@((context as ChatElement).OrientationLeft ? JustifyContent.Left : JustifyContent.Right)"
                         Orientation="Orientation.Horizontal">
               <RadzenIcon Icon="@((context as ChatElement)?.IconName)"></RadzenIcon>
            </RadzenStack>
            <RadzenMarkdown style="width: 100%">
               @((MarkupString)((context as ChatElement)?.Text.Replace(Environment.NewLine, "<br/>") ?? string.Empty))
            </RadzenMarkdown>
            <br/>
            @((context as ChatElement)?.RenderFragment)

         </RadzenCard>
      </Template>
   </RadzenListBox>
   @if (_busy)
   {
      <RadzenButton Text="Cancel" Icon="cancel"  Click="Cancel"/>
   }
</RadzenStack>

@code{

   private string _prompt = string.Empty;
   private Agent? _agent;
   private List<ChatElement> _chatlist = new List<ChatElement>();
   private ChatElement _selectedChatElement = new ChatElement();
   private bool _busy = false;
   private HCommand? _hcommand;
   private AgentConfig _config = new AgentConfig() ;
   private CancellationTokenSource? _cts; // Token de cancelación

   protected override void OnInitialized()
   {
      _config = Context.Get<AgentConfig>() ?? new AgentConfig();
      _agent = new Agent("chat",_config, GesCom, Logger);
      base.OnInitialized();
   }

   private async Task Send()
   {
      if (string.IsNullOrWhiteSpace(_prompt))
      {
         // Validación: _prompt vacío o inválido
         _chatlist.Add(new ChatElement
         {
            Text = "El mensaje no puede estar vacío.",
            IconName = "warning"
         });
         return;
      }

      if (_agent == null || GesCom == null)
      {
         // Validación: _agent y GesCom deben estar inicializados
         _chatlist.Add(new ChatElement
         {
            Text = "El agente o el sistema de gestión de comandos no está inicializado.",
            IconName = "error"
         });
         return;
      }
      // Resetear el CancellationTokenSource anterior (si existiera)
      _cts?.Cancel();
      _cts = new CancellationTokenSource();

      // Añadir el mensaje del usuario a la lista de chats
      _chatlist.Add(new ChatElement
      {
         Text = _prompt,
         IconName = "person"
      });

      // Inicialización de variables
      _busy = true;
      ChatElement response = new ChatElement();
      WidgetDef? widgetDef = null;
      _hcommand = null;

      try
      {
         // Uso de un CancellationToken controlado sería ideal en lugar de uno vacío.
         var resquery = await _agent.Query(_prompt,  _cts.Token);
         AgentResponse agentResponse = GetResponseOrError(resquery);

         response.IconName = "smart_toy";
         response.Text = agentResponse.Output.Response + agentResponse.Output.Error;
         response.OrientationLeft = false;

         // Buscar el comando asociado al widget
         _hcommand = GesCom.GetCommandList().FirstOrDefault(x => x.CommandKey == agentResponse.Output.Widget);

         if (_hcommand != null)
         {
            // Determinar si es un widget o una página de configuración
            if (_hcommand.Roles.Contains("widget") || _hcommand.Roles.Contains("configpage"))
            {
               widgetDef = GesCom.RunCommand<WidgetDef>(agentResponse.Output.Widget);
            }
            else
            {
               // Intenta cargar el tipo dinámico
               var type = Type.GetType("Horizonte.AdminUi.HorizonteSettings.Components.ExecuteCommand, Horizonte.AdminUi.HorizonteSettings");
               if (type == null)
               {
                  response.Text = "No se pudo cargar el tipo de widget proporcionado.";
                  response.IconName = "error";
                  _chatlist.Add(response);
                  _busy = false;
                  return;
               }

               widgetDef = new WidgetDef()
               {
                  Type = type,
                  Parameters = new Dictionary<string, object>() { { "Command", _hcommand } },
               };
            }

            // Ejecutar el comando para renderizar el widget
            response.RenderFragment = GesCom.RunCommand<RenderFragment>("HorizonteGui_RenderWidget", new object[] { widgetDef })
                                      ?? (builder => builder.AddMarkupContent(0, "<p>Error al cargar el widget</p>"));
         }
         else
         {
            response.RenderFragment = null;
         }
      }
      catch (Exception e)
      {
         // Manejo de excepciones controlado
         Logger.LogError($"Error durante el procesamiento del mensaje: {e}");
         response.Text = "Ocurrió un error al procesar la solicitud.";
         response.IconName = "error";
      }

      // Añadir la respuesta al chat
      _chatlist.Add(response);

      // Restablecer estado
      _prompt = string.Empty;
      await InvokeAsync(StateHasChanged); // Método para actualizar el estado en Blazor.
      _busy = false;
   }

   private AgentResponse GetResponseOrError(IReadOnlyList<ChatMessageContent> response)
   {
      if (response == null || !response.Any())
      {
         return new AgentResponse
         {
            Output = new Output
            {
               Error = "Respuesta vacía o nula de chatService"
            }
         };
      }

      if (string.IsNullOrEmpty(response[0].Content))
      {
         return new AgentResponse
         {
            Output = new Output
            {
               Error = "El contenido de la respuesta es nulo o vacío"
            }
         };
      }

      // Si  es válido, deserializamos y devolvemos el resultado
      Output output = new Output();
      try 
      {
         output = JsonSerializer.Deserialize<Output>(response[0].Content!);

      }
      catch (Exception e)
      {
         Logger.LogError("Error al serializar la respuesta del LLM");
         output!.Response = response[0].Content!;
      }
      return new AgentResponse { Output = output! };
   }



   private async Task ClearChat()
   {
      _agent?.InitializeAgent();
      _chatlist.Clear();
   }
   
   private void Cancel()
   {
      // Cancela la operación en curso
      _cts?.Cancel();
      _busy = false;
   }
   
   RenderFragment? CreateDynamicComponent(Type type)
   {
      WidgetDef widgetDef = new WidgetDef()
      {
         Type = type,
         Parameters = null
      };
      return GesCom.RunCommand<RenderFragment>("HorizonteGui_RenderWidget",
         new object[] { widgetDef });
   }

}