@using Horizonte
@inject IHContext Context
<RadzenCard style="width: 100%" >
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Agente"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
            <RadzenButton Text="Grabar" Variant="Variant.Outlined" Icon="save" Size="ButtonSize.Small"
                          Click="Update"></RadzenButton>
        </div>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical">
        <div>
            <RadzenText Text="Url del servicio"/>
            <RadzenTextBox @bind-value="_agentConfig.Url"/>
        </div>
        <div>
            <RadzenText Text="API Key"/>
            <RadzenTextBox @bind-value="_agentConfig.ApiKey"/>
        </div>
        <div>
            <RadzenText Text="Modelo"/>
            <RadzenTextBox @bind-value="_agentConfig.ModelId"/>
        </div>
        <div>
            <RadzenText Text="Modelo Embedding"/>
            <RadzenTextBox @bind-value="_agentConfig.EmbeddingModelId"/>
        </div>

        <div style="width: 100%" >
            <RadzenText Text="System Prompt"/>
            <RadzenTextArea style="width: 100%"  @bind-value="_agentConfig.SystemPrompt"/>
        </div>
    </RadzenStack>
    <br/>
</RadzenCard>

@code {
    AgentConfig _agentConfig = new();

    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    private void Get()
    {
        _agentConfig = Context.Get<AgentConfig>() ?? new AgentConfig();
    }

    private void Update()
    {
        Context.Update(_agentConfig);
    }

}