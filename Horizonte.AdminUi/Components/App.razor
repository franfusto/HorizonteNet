@inject IHContext HContext
<!DOCTYPE html>
<html lang="en">

<head>
    <title></title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="/_content/horizonte.adminui/app.css"/>
    <link rel="stylesheet" href="/_content/horizonte.adminui/MainLayout.css"/>
    <link rel="stylesheet" href="/_content/Horizonte.WorkFlows/css/workflow-nodes.css"/>
    
    <!-- ... -->
    <link href="_content/Z.Blazor.Diagrams/style.min.css" rel="stylesheet" />
    <!-- If you want the default style -->
    <link href="_content/Z.Blazor.Diagrams/default.styles.min.css" rel="stylesheet" />

    <HeadOutlet @rendermode="InteractiveServer"/>
    <RadzenTheme Theme="@_themedef" @rendermode="InteractiveServer"/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<script src="/_content/horizonte.adminui/blazor.web.js"></script>
<script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
<script>
    window.saveAsFile = (filename, content) => {
        var link = document.createElement('a');
        link.download = filename;
        link.href = "data:application/octet-stream;base64," + content;
        document.body.appendChild(link); // Needed for Firefox
        link.click();
        document.body.removeChild(link);
    };
    
    window.fixMarkdownLinks = () => {
        const containers = document.querySelectorAll('.markdown-container');
        containers.forEach(container => {
            const links = container.querySelectorAll('a');
            links.forEach(link => {
                if (!link.getAttribute('target')) {
                    link.setAttribute('target', '_blank');
                    link.setAttribute('rel', 'noopener noreferrer');
                }
            });
        });
    };
</script>
<script src="_content/Z.Blazor.Diagrams/script.min.js"></script>
<script src="_content/BlazorMonaco/jsInterop.js"></script>
<script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
<script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
</body>

</html>

@code
{
    private string _themedef = string.Empty;

    protected override void OnInitialized()
    {
        _themedef = HContext.Get<HGuiSettings>()?.DefaultTheme ?? "material-dark";
        base.OnInitialized();
    }

}