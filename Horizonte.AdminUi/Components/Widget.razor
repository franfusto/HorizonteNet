@if (WidgetDef == null)
{
    <RadzenText Text="Error al mostrar el widget" TextStyle="TextStyle.Subtitle1"/>
}
else
{
    <DynamicComponent
        Type="@WidgetDef.Type"
        Parameters="@WidgetDef.Parameters" />
}


@code {

    /// <summary>
    /// Obtiene o establece la definición del widget a renderizar dinámicamente.
    /// </summary>
    [Parameter]
    public WidgetDef? WidgetDef { get; set; }
}