<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <!--
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DoNotCopyLocalIfInGac>true</DoNotCopyLocalIfInGac>
        <TargetFramework>net8.0</TargetFramework>
        <Authors>franfusto</Authors>
        <Description>Entorno modular para net8 basado en blazor.radzen</Description>
        <PackageProjectUrl>https://github.com/franfusto/HorizonteNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/franfusto/HorizonteNet</RepositoryUrl>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DebugType>embedded</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugSymbols>true</DebugSymbols>
      <DebugType>embedded</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="logconfig.xml"/>
        <None Remove="defaults.json"/>
        <Compile Remove="Interfaces\IHModManager.cs" />
        <Compile Remove="Services\HModManager.cs" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="8.0.2" />
      <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="8.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="System.Text.Json" Version="8.0.5" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    </ItemGroup>

</Project>
