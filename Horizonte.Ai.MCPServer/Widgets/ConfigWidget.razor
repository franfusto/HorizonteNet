@inject IhContext Context
@inject IHGesCom GesCom

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Configuración de Horizonte.Ai MCP Server" class="rz-m-0" />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Icon="refresh" Variant="Variant.Outlined" Click="Get" Text="" />
            <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Click="Update" Text="Guardar" />
        </RadzenStack>
    </RadzenStack>

    <RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Parámetros del Servidor">
                <RadzenStack Gap="1rem" Class="rz-p-4">
                    <RadzenFormField Text="URL" Variant="Variant.Outlined">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@_config.Url" style="width: 100%;" Placeholder="http://localhost:5005" />
                        </ChildContent>
                        <Helper>
                            <RadzenText TextStyle="TextStyle.Caption" Text="Dirección base donde escucha o se expone el servidor MCP." />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="Ruta del Endpoint (Path)" Variant="Variant.Outlined">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@_config.Path" style="width: 100%;" Placeholder="mcp" />
                        </ChildContent>
                        <Helper>
                            <RadzenText TextStyle="TextStyle.Caption" Text="Ruta relativa para el endpoint SSE/HTTP del protocolo MCP." />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="Tipo Middleware Validador" Variant="Variant.Outlined">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@_config.ValidatorMiddlewareType" style="width: 100%;" Placeholder="Horizonte.Ai.MCPServer.Middleware.ValidatorMiddleware" />
                        </ChildContent>
                        <Helper>
                            <RadzenText TextStyle="TextStyle.Caption" Text="Nombre de tipo completo del middleware para validación de peticiones MCP." />
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Comandos Expuestos">
                <RadzenStack Gap="1rem" Class="rz-p-4">
                    <RadzenCard Variant="Variant.Filled" Class="rz-p-3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Añadir nuevo comando MCP" Class="rz-mb-2" />
                        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenDropDown TValue="string"
                                                Data="@_availableCommandKeys"
                                                @bind-Value="@_newCommandKey"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Seleccionar o escribir comando..."
                                                AllowCustomValues="true"
                                                Change="@OnCommandSelected"
                                                Style="width: 100%;" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenTextBox @bind-Value="@_newCommandDescription"
                                               Placeholder="Descripción personalizada para clientes MCP..."
                                               Style="width: 100%;" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenButton Text="Añadir"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="AddCommand"
                                              Style="width: 100%;" />
                            </RadzenColumn>
                        </RadzenRow>
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat" Class="rz-mt-2" AllowClose="true" Close="@(() => _errorMessage = null)">
                                @_errorMessage
                            </RadzenAlert>
                        }
                    </RadzenCard>

                    @if (_config.Commands.Count == 0)
                    {
                        <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                            No hay comandos expuestos actualmente. Añade comandos para que los clientes MCP puedan ejecutarlos.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid @ref="_grid" Data="@_config.Commands" TItem="MCPCommandDef" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn TItem="MCPCommandDef" Property="Command" Title="Comando" Width="35%">
                                    <Template Context="cmd">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenBadge BadgeStyle="@(IsKnownCommand(cmd.Command) ? BadgeStyle.Success : BadgeStyle.Warning)"
                                                         Text="@(IsKnownCommand(cmd.Command) ? "Registrado" : "Desconocido")"
                                                         IsPill="true" />
                                            <RadzenText TextStyle="TextStyle.Body2" Text="@cmd.Command" Class="rz-font-weight-bold" />
                                        </RadzenStack>
                                    </Template>
                                    <EditTemplate Context="cmd">
                                        <RadzenTextBox @bind-Value="cmd.Command" Style="width: 100%;" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="MCPCommandDef" Property="Description" Title="Descripción" Width="55%">
                                    <Template Context="cmd">
                                        <RadzenTextBox @bind-Value="cmd.Description"
                                                       Placeholder="Descripción para clientes MCP"
                                                       Style="width: 100%;" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="MCPCommandDef" Title="Acciones" TextAlign="TextAlign.Center" Width="10%">
                                    <Template Context="cmd">
                                        <RadzenButton Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => RemoveCommand(cmd))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Recursos">
                <RadzenStack Gap="1rem" Class="rz-p-4">
                    <RadzenCard Variant="Variant.Filled" Class="rz-p-3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Añadir tipo de recurso" Class="rz-mb-2" />
                        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="10">
                                <RadzenTextBox @bind-Value="@_newResourceType"
                                               Placeholder="Nombre completo del tipo de recurso..."
                                               Style="width: 100%;" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenButton Text="Añadir"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="AddResourceType"
                                              Style="width: 100%;" />
                            </RadzenColumn>
                        </RadzenRow>
                        @if (!string.IsNullOrEmpty(_resourcesErrorMessage))
                        {
                            <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat" Class="rz-mt-2" AllowClose="true" Close="@(() => _resourcesErrorMessage = null)">
                                @_resourcesErrorMessage
                            </RadzenAlert>
                        }
                    </RadzenCard>

                    @if (_config.ResourcesTypes.Count == 0)
                    {
                        <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                            No hay tipos de recursos configurados.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid @ref="_resourcesGrid" Data="@_config.ResourcesTypes" TItem="string" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Tipo de Recurso" Width="90%">
                                    <Template Context="resType">
                                        <RadzenText TextStyle="TextStyle.Body2" Text="@resType" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Acciones" TextAlign="TextAlign.Center" Width="10%">
                                    <Template Context="resType">
                                        <RadzenButton Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => RemoveResourceType(resType))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Prompts">
                <RadzenStack Gap="1rem" Class="rz-p-4">
                    <RadzenCard Variant="Variant.Filled" Class="rz-p-3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Añadir tipo de prompt" Class="rz-mb-2" />
                        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="10">
                                <RadzenTextBox @bind-Value="@_newPromptType"
                                               Placeholder="Nombre completo del tipo de prompt..."
                                               Style="width: 100%;" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenButton Text="Añadir"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="AddPromptType"
                                              Style="width: 100%;" />
                            </RadzenColumn>
                        </RadzenRow>
                        @if (!string.IsNullOrEmpty(_promptsErrorMessage))
                        {
                            <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat" Class="rz-mt-2" AllowClose="true" Close="@(() => _promptsErrorMessage = null)">
                                @_promptsErrorMessage
                            </RadzenAlert>
                        }
                    </RadzenCard>

                    @if (_config.PromptsTypes.Count == 0)
                    {
                        <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                            No hay tipos de prompts configurados.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid @ref="_promptsGrid" Data="@_config.PromptsTypes" TItem="string" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Tipo de Prompt" Width="90%">
                                    <Template Context="promptType">
                                        <RadzenText TextStyle="TextStyle.Body2" Text="@promptType" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Acciones" TextAlign="TextAlign.Center" Width="10%">
                                    <Template Context="promptType">
                                        <RadzenButton Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => RemovePromptType(promptType))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code {
    private RadzenDataGrid<MCPCommandDef>? _grid;
    private RadzenDataGrid<string>? _resourcesGrid;
    private RadzenDataGrid<string>? _promptsGrid;
    private MCPServerConfig _config = new();
    private List<string> _availableCommandKeys = [];
    private Dictionary<string, string> _commandDescriptions = new(StringComparer.OrdinalIgnoreCase);

    private string? _newCommandKey;
    private string? _newCommandDescription;
    private string? _errorMessage;

    private string? _newResourceType;
    private string? _resourcesErrorMessage;

    private string? _newPromptType;
    private string? _promptsErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        LoadAvailableCommands();
        await Get();
        await base.OnInitializedAsync();
    }

    private void LoadAvailableCommands()
    {
        try
        {
            var commands = GesCom.GetCommandList()?.ToList() ?? [];
            _availableCommandKeys = commands
                .Select(c => c.CommandKey)
                .Where(key => !string.IsNullOrWhiteSpace(key))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(key => key)
                .ToList();

            _commandDescriptions = commands
                .Where(c => !string.IsNullOrWhiteSpace(c.CommandKey))
                .GroupBy(c => c.CommandKey, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => g.First().Description ?? string.Empty,
                    StringComparer.OrdinalIgnoreCase
                );
        }
        catch
        {
            _availableCommandKeys = [];
            _commandDescriptions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task Get()
    {
        _config = Context.Get<MCPServerConfig>() ?? new MCPServerConfig();
        _config.Commands ??= [];
        _config.ResourcesTypes ??= [];
        _config.PromptsTypes ??= [];
        if (_grid != null)
        {
            await _grid.Reload();
        }
        if (_resourcesGrid != null)
        {
            await _resourcesGrid.Reload();
        }
        if (_promptsGrid != null)
        {
            await _promptsGrid.Reload();
        }
        StateHasChanged();
    }

    private void Update()
    {
        _config.Commands ??= [];
        _config.ResourcesTypes ??= [];
        _config.PromptsTypes ??= [];
        Context.Update(_config);
    }

    private void OnCommandSelected(object? value)
    {
        if (value is string key && !string.IsNullOrWhiteSpace(key))
        {
            if (string.IsNullOrWhiteSpace(_newCommandDescription) && _commandDescriptions.TryGetValue(key, out var desc))
            {
                _newCommandDescription = desc;
            }
        }
    }

    private async Task AddCommand()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_newCommandKey))
        {
            _errorMessage = "Debe indicar el nombre del comando.";
            return;
        }

        var trimmedKey = _newCommandKey.Trim();

        if (_config.Commands.Any(c => string.Equals(c.Command, trimmedKey, StringComparison.OrdinalIgnoreCase)))
        {
            _errorMessage = $"El comando '{trimmedKey}' ya está en la lista de comandos expuestos.";
            return;
        }

        _config.Commands.Add(new MCPCommandDef
        {
            Command = trimmedKey,
            Description = _newCommandDescription?.Trim() ?? string.Empty
        });

        _newCommandKey = null;
        _newCommandDescription = null;

        if (_grid != null)
        {
            await _grid.Reload();
        }
        StateHasChanged();
    }

    private async Task RemoveCommand(MCPCommandDef cmd)
    {
        _config.Commands.Remove(cmd);

        if (_grid != null)
        {
            await _grid.Reload();
        }
        StateHasChanged();
    }

    private async Task AddResourceType()
    {
        _resourcesErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_newResourceType))
        {
            _resourcesErrorMessage = "Debe indicar el tipo de recurso.";
            return;
        }

        var trimmedType = _newResourceType.Trim();

        if (_config.ResourcesTypes.Any(t => string.Equals(t, trimmedType, StringComparison.OrdinalIgnoreCase)))
        {
            _resourcesErrorMessage = $"El tipo de recurso '{trimmedType}' ya está en la lista.";
            return;
        }

        _config.ResourcesTypes.Add(trimmedType);
        _newResourceType = null;

        if (_resourcesGrid != null)
        {
            await _resourcesGrid.Reload();
        }
        StateHasChanged();
    }

    private async Task RemoveResourceType(string resType)
    {
        _config.ResourcesTypes.Remove(resType);

        if (_resourcesGrid != null)
        {
            await _resourcesGrid.Reload();
        }
        StateHasChanged();
    }

    private async Task AddPromptType()
    {
        _promptsErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_newPromptType))
        {
            _promptsErrorMessage = "Debe indicar el tipo de prompt.";
            return;
        }

        var trimmedType = _newPromptType.Trim();

        if (_config.PromptsTypes.Any(t => string.Equals(t, trimmedType, StringComparison.OrdinalIgnoreCase)))
        {
            _promptsErrorMessage = $"El tipo de prompt '{trimmedType}' ya está en la lista.";
            return;
        }

        _config.PromptsTypes.Add(trimmedType);
        _newPromptType = null;

        if (_promptsGrid != null)
        {
            await _promptsGrid.Reload();
        }
        StateHasChanged();
    }

    private async Task RemovePromptType(string promptType)
    {
        _config.PromptsTypes.Remove(promptType);

        if (_promptsGrid != null)
        {
            await _promptsGrid.Reload();
        }
        StateHasChanged();
    }

    private bool IsKnownCommand(string? commandKey)
    {
        return !string.IsNullOrWhiteSpace(commandKey) &&
               _availableCommandKeys.Contains(commandKey.Trim(), StringComparer.OrdinalIgnoreCase);
    }
}