@using Horizonte.Extension.WorkFlows
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using Horizonte.WorkFlows.Components
@using Point = Blazor.Diagrams.Core.Geometry.Point
<style>
    .diagram-container {
        width: 100%;
        height: calc(100vh - 350px);
        border: 1px solid var(--rz-border-color);
        background-color: var(--rz-background-color);
    }

    /* Personalización de los nodos del diagrama para que coincidan con Radzen */
    .diagram-container .default-node {
        background-color: var(--rz-base-background-color) !important;
        border-color: var(--rz-primary) !important;
        color: var(--rz-text-color) !important;
        border-radius: var(--rz-border-radius);
    }

    .diagram-container .default-node .title {
        color: var(--rz-text-color) !important;
    }

    .diagram-container .diagram-link path {
        stroke: var(--rz-primary) !important;
    }

    .diagram-container .diagram-link .marker path {
        fill: var(--rz-primary) !important;
        stroke: var(--rz-primary) !important;
    }

    /* Selectores adicionales para asegurar que el color se aplique */
    .diagram-container svg.diagram-svg .diagram-link path {
        stroke: var(--rz-primary) !important;
    }

    .diagram-container svg.diagram-svg .diagram-link .marker path {
        fill: var(--rz-primary) !important;
        stroke: var(--rz-primary) !important;
    }
    .diagram-container .navigator-widget {
        border: 1px solid var(--rz-border-color);
        background-color: var(--rz-base-background-color);
        position: absolute;
    }

    .diagram-toolbox {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 100;
        background-color: var(--rz-base-background-color);
        border: 1px solid var(--rz-border-color);
        border-radius: var(--rz-border-radius);
        padding: 5px;
        box-shadow: var(--rz-box-shadow);
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
</style>

@if (WorkFlowDef != null)
{
    <RadzenStack Gap="1rem" Style="flex-grow: 1;">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenFormField Text="Nombre" Style="flex-grow: 1;">
                <RadzenTextBox @bind-Value="@WorkFlowDef.Name" Style="width: 100%;" />
            </RadzenFormField>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => OnSave.InvokeAsync())" Tooltip="Guardar cambios" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => OnDelete.InvokeAsync())" Tooltip="Eliminar workflow" />
            </RadzenStack>
        </RadzenStack>

        <div class="diagram-container" style="position: relative;">
            <div class="diagram-toolbox">
                <RadzenButton Icon="login" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Tooltip="Entrada (In)" Click="@(() => AddNode(WorkFlowNodeTypes.In))" />
                <RadzenButton Icon="reorder" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Tooltip="Nodo (Node)" Click="@(() => AddNode(WorkFlowNodeTypes.Node))" />
                <RadzenButton Icon="logout" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Tooltip="Salida (Out)" Click="@(() => AddNode(WorkFlowNodeTypes.Out))" />
            </div>
            <CascadingValue Value="_diagram" IsFixed="true">
                <DiagramCanvas></DiagramCanvas>
            </CascadingValue>
        </div>
    </RadzenStack>
}

@code {
    [Parameter] public WorkFlowDef? WorkFlowDef
    {
        get => Getdef();
        set;
    }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private BlazorDiagram _diagram = new BlazorDiagram();
    private string? _currentWorkFlowId = null;

    private WorkFlowDef? Getdef()
    {
        //desde _diagram debemos obtener WorkFlowDef?
        return new();
    }

    protected override void OnInitialized()
    {
        _diagram.RegisterComponent<NodeInModel, NodeIn>();
        _diagram.RegisterComponent<NodeOperationModel, NodeOperation>();
        _diagram.RegisterComponent<NodeOutModel, NodeOut>();
        base.OnInitialized();
    }

    private void AddNode(WorkFlowNodeTypes type)
    {
        if (WorkFlowDef == null) return;
        WorkFlowNode nodeDef = new WorkFlowNode
        {
            Id = Guid.NewGuid().ToString(),
            Name = $"Nuevo {type}",
            Type = type,
            PosX = 100,
            PosY = 100
        };

        NodeModel nodeModel;
        switch (type)
        {
            case WorkFlowNodeTypes.In:
                nodeModel = new NodeInModel(nodeDef);
                nodeModel.AddPort(PortAlignment.Right);
                break;
            case WorkFlowNodeTypes.Out:
                nodeModel = new NodeOutModel(nodeDef);
                nodeModel.AddPort(PortAlignment.Left);
                break;
            default:
                nodeModel = new NodeOperationModel(nodeDef);
                nodeModel.AddPort(PortAlignment.Left);
                nodeModel.AddPort(PortAlignment.Right);
                nodeModel.AddPort(PortAlignment.Right);
                nodeModel.AddPort(PortAlignment.Right);
                break;
        }

        _diagram.Nodes.Add(nodeModel);
        WorkFlowDef.Nodes.Add(nodeDef);
    }
}