@using Horizonte.Extension.WorkFlows
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using Horizonte.WorkFlows.Components
@using Horizonte.WorkFlows.NodeModels
@using Point = Blazor.Diagrams.Core.Geometry.Point
@inject IHorizonteEnv HorizonteEnv
<style>

    .node {
        width: 300px;
        padding: 1rem !important;
        position: relative;
        border-radius: var(--rz-border-radius);
        box-shadow: var(--rz-shadow-5);
    }

    .node h5 {
        margin-top: 0;
        color: var(--rz-text-color);
        font-weight: var(--rz-font-weight-bold);
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .node .diagram-port {
        position: absolute;
        width: 12px;
        height: 12px;
        background-color: var(--rz-primary);
        border: 2px solid var(--rz-base-100);
        border-radius: 50%;
        cursor: crosshair;
        z-index: 10;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .node .diagram-port:hover {
        transform: scale(1.4);
        background-color: var(--rz-secondary);
    }

    .node .diagram-port.top {
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
    }

    .node .diagram-port.bottom {
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
    }

    .node .diagram-port.left {
        left: -6px;
        top: 50%;
        transform: translateY(-50%);
    }

    .node .diagram-port.right {
        right: -6px;
        top: 50%;
        transform: translateY(-50%);
    }

    .node .port-container .diagram-port.top,
    .node .port-container .diagram-port.bottom,
    .node .port-container .diagram-port.left,
    .node .port-container .diagram-port.right {
        top: 0;
        left: 0;
        right: auto;
        bottom: auto;
        transform: translate(-50%, -50%);
    }

    .node .port-container {
        position: absolute;
        width: 0;
        height: 0;
    }


    .diagram-container {
        width: 100%;
        height: calc(100vh - 350px);
        border: 1px solid var(--rz-border-color);
        background-color: var(--rz-background-color);
    }

    /* Personalización de los nodos del diagrama para que coincidan con Radzen */
    .diagram-container .default-node {
        background-color: var(--rz-base-background-color) !important;
        border-color: var(--rz-primary) !important;
        color: var(--rz-text-color) !important;
        border-radius: var(--rz-border-radius);
    }

    .diagram-container .default-node .title {
        color: var(--rz-text-color) !important;
    }

    .diagram-container .diagram-link path {
        stroke: var(--rz-primary) !important;
    }

    .diagram-container .diagram-link .marker path {
        fill: var(--rz-primary) !important;
        stroke: var(--rz-primary) !important;
    }

    /* Selectores adicionales para asegurar que el color se aplique */
    .diagram-container svg.diagram-svg .diagram-link path {
        stroke: var(--rz-primary) !important;
    }

    .diagram-container svg.diagram-svg .diagram-link .marker path {
        fill: var(--rz-primary) !important;
        stroke: var(--rz-primary) !important;
    }

    .diagram-container .navigator-widget {
        border: 1px solid var(--rz-border-color);
        background-color: var(--rz-base-background-color);
        position: absolute;
    }

    .diagram-toolbox {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 100;
        background-color: var(--rz-base-background-color);
        border: 1px solid var(--rz-border-color);
        border-radius: var(--rz-border-radius);
        padding: 5px;
        box-shadow: var(--rz-box-shadow);
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
</style>

@if (WorkFlowDef != null)
{
    <RadzenStack Gap="1rem" Style="flex-grow: 1;">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenFormField Text="Nombre" Style="flex-grow: 1;">
                <RadzenTextBox @bind-Value="@WorkFlowDef.Name" Style="width: 100%;"/>
            </RadzenFormField>
            @if (DesignerMode == DesignerMode.Design)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="manufacturing" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@BuildWorkflow" Tooltip="Build"/>
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@Save" Tooltip="Guardar cambios"/>
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@(() => OnDelete.InvokeAsync())"
                                  Tooltip="Eliminar workflow"/>
                    <RadzenButton Icon="exit_to_app" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@SetModeShow"/>
                </RadzenStack>
            }
            @if (DesignerMode == DesignerMode.Show)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="motion_play" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@SetModeRun"/>
                    <RadzenButton Icon="draw" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@SetModeDesign"/>
                </RadzenStack>
            }
            @if (DesignerMode == DesignerMode.Run)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="exit_to_app" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Click="@SetModeShow"/>
                </RadzenStack>
            }
        </RadzenStack>

        <div class="diagram-container" style="position: relative;">
            @if (DesignerMode == DesignerMode.Design)
            {
                <div class="diagram-toolbox">
                    <RadzenButton Icon="login" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Tooltip="Entrada (In)"
                                  Click="@(() => AddNode(WorkFlowNodeTypes.In))"/>
                    <RadzenButton Icon="reorder" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Tooltip="Nodo (Node)"
                                  Click="@(() => AddNode(WorkFlowNodeTypes.Node))"/>
                    <RadzenButton Icon="logout" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                  Size="ButtonSize.Medium" Tooltip="Salida (Out)"
                                  Click="@(() => AddNode(WorkFlowNodeTypes.Out))"/>
                </div>
            }
            <CascadingValue Value="_diagram" IsFixed="true">
                <CascadingValue Value="DesignerMode">
                    <DiagramCanvas></DiagramCanvas>
                </CascadingValue>
            </CascadingValue>
        </div>
    </RadzenStack>
}

@code {

    [Parameter]
    public WorkFlowDef? WorkFlowDef
    {
        get { return _currentWorkFlowNode; }
        set
        {
            if (_currentWorkFlowNode?.Id != value?.Id)
            {
                _currentWorkFlowNode = value;
                LoadWorkFlow(value);
            }
        }
    }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public DesignerMode DesignerMode { get; set; } = DesignerMode.Show;

    private BlazorDiagram _diagram = new BlazorDiagram();
    private WorkFlowDef? _currentWorkFlowNode;

    private void LoadWorkFlow(WorkFlowDef? workflow)
    {
        _diagram.Nodes.Clear();
        _diagram.Links.Clear();

        if (workflow == null) return;

        // Cargar Nodos
        foreach (var nodeDef in workflow.Nodes)
        {
            NodeModel nodeModel;
            switch (nodeDef.Type)
            {
                case WorkFlowNodeTypes.In:
                    nodeModel = new NodeInModel(nodeDef);
                    break;
                case WorkFlowNodeTypes.Out:
                    nodeModel = new NodeOutModel(nodeDef);
                    break;
                default:
                    var opModel = new NodeOperationModel(nodeDef);
                    opModel.OnPortsChanged += (alignment, count) => HandlePortsChanged(opModel, alignment, count);
                    nodeModel = opModel;
                    break;
            }

            // Restaurar Puertos
            foreach (var portDef in nodeDef.InPorts)
            {
                nodeModel.AddPort(new PortModel(portDef.Id, nodeModel, Enum.Parse<PortAlignment>(portDef.Alignment)));
            }

            foreach (var portDef in nodeDef.OutPorts)
            {
                nodeModel.AddPort(new PortModel(portDef.Id, nodeModel, Enum.Parse<PortAlignment>(portDef.Alignment)));
            }

            _diagram.Nodes.Add(nodeModel);
        }

        // Cargar Enlaces
        foreach (var linkDef in workflow.Links)
        {
            var sourceNode = _diagram.Nodes.FirstOrDefault(n => n.Id == linkDef.SourceNodeId);
            var targetNode = _diagram.Nodes.FirstOrDefault(n => n.Id == linkDef.TargetNodeId);

            if (sourceNode != null && targetNode != null)
            {
                var sourcePort = sourceNode.Ports.FirstOrDefault(p => p.Id == linkDef.SourcePortId);
                var targetPort = targetNode.Ports.FirstOrDefault(p => p.Id == linkDef.TargetPortId);

                if (sourcePort != null && targetPort != null)
                {
                    var link = new LinkModel(linkDef.Id, sourcePort, targetPort);
                    _diagram.Links.Add(link);
                }
            }
        }
    }

    private void SetModeRun() => DesignerMode = DesignerMode.Run;
    private void SetModeShow() => DesignerMode = DesignerMode.Show;
    private void SetModeDesign() => DesignerMode = DesignerMode.Design;

    private async Task BuildWorkflow()
    {
        try
        {
            Getdef();
            //aqui hacemos el build
            object WorkFlow = WorkFlowDef.Build(HorizonteEnv);
        }
        catch (Exception e)
        {
            // interceptar error
            Console.WriteLine(e);
        }
    }

    private async Task Save()
    {
        Getdef();
        await OnSave.InvokeAsync();
    }

    private WorkFlowDef? Getdef()
    {
        if (WorkFlowDef == null) return null;

        WorkFlowDef.Nodes.Clear();
        foreach (var node in _diagram.Nodes)
        {
            WorkFlowNode? nodeDef = null;
            if (node is NodeInModel inModel) nodeDef = inModel.Node;
            else if (node is NodeOperationModel opModel) nodeDef = opModel.Node;
            else if (node is NodeOutModel outModel) nodeDef = outModel.Node;

            if (nodeDef != null)
            {
                nodeDef.PosX = (int)node.Position.X;
                nodeDef.PosY = (int)node.Position.Y;

                // Actualizar puertos en el nodeDef para reflejar el estado del diagrama
                var leftPorts = node.Ports.Where(p => p.Alignment == PortAlignment.Left).ToList();
                nodeDef.InPorts = leftPorts
                    .Select((p, i) => new NodePort { Id = p.Id, Name = $"In_{i}", Alignment = p.Alignment.ToString() })
                    .ToArray();

                var rightPorts = node.Ports.Where(p => p.Alignment == PortAlignment.Right).ToList();
                nodeDef.OutPorts = rightPorts
                    .Select((p, i) => new NodePort { Id = p.Id, Name = $"Out_{i}", Alignment = p.Alignment.ToString() })
                    .ToArray();

                WorkFlowDef.Nodes.Add(nodeDef);
            }
        }

        WorkFlowDef.Links.Clear();
        foreach (var link in _diagram.Links)
        {
            if (link.Source is SinglePortAnchor sourceAnchor &&
                link.Target is SinglePortAnchor targetAnchor)
            {
                WorkFlowDef.Links.Add(new WorkFlowLink
                {
                    Id = link.Id,
                    SourceNodeId = sourceAnchor.Port.Parent.Id,
                    SourcePortId = sourceAnchor.Port.Id,
                    TargetNodeId = targetAnchor.Port.Parent.Id,
                    TargetPortId = targetAnchor.Port.Id
                });
            }
        }

        return WorkFlowDef;
    }


    protected override void OnInitialized()
    {
        _diagram.RegisterComponent<NodeInModel, NodeIn>();
        _diagram.RegisterComponent<NodeOperationModel, NodeOperation>();
        _diagram.RegisterComponent<NodeOutModel, NodeOut>();
        base.OnInitialized();
    }

    private void AddNode(WorkFlowNodeTypes type)
    {
        if (WorkFlowDef == null) return;
        WorkFlowNode nodeDef = new WorkFlowNode
        {
            Id = Guid.NewGuid().ToString(),
            Name = $"Nuevo {type}",
            Type = type,
            PosX = 100,
            PosY = 100
        };

        NodeModel nodeModel;
        switch (type)
        {
            case WorkFlowNodeTypes.In:
                nodeModel = new NodeInModel(nodeDef);
                nodeModel.AddPort(PortAlignment.Right);
                break;
            case WorkFlowNodeTypes.Out:
                nodeModel = new NodeOutModel(nodeDef);
                nodeModel.AddPort(PortAlignment.Left);
                break;
            default:
                var opModel = new NodeOperationModel(nodeDef);
                opModel.OnPortsChanged += (alignment, count) => HandlePortsChanged(opModel, alignment, count);
                nodeModel = opModel;
                nodeModel.AddPort(PortAlignment.Left);
                nodeModel.AddPort(PortAlignment.Right);
                break;
        }

        _diagram.Nodes.Add(nodeModel);
    }

    private async void HandlePortsChanged(NodeModel node, PortAlignment alignment, int count)
    {
        var currentPorts = node.Ports.Where(p => p.Alignment == alignment).ToList();
        var currentCount = currentPorts.Count;

        if (count > currentCount)
        {
            for (int i = 0; i < count - currentCount; i++)
            {
                node.AddPort(alignment);
            }
        }
        else if (count < currentCount)
        {
            for (int i = 0; i < currentCount - count; i++)
            {
                var portToRemove = currentPorts.Last();

                // Eliminar enlaces conectados al puerto que se va a quitar
                var linksToRemove = _diagram.Links
                    .Where(l => (l.Source is SinglePortAnchor source && source.Port == portToRemove) ||
                                (l.Target is SinglePortAnchor target && target.Port == portToRemove))
                    .ToList();
                foreach (var link in linksToRemove)
                {
                    _diagram.Links.Remove(link);
                }

                node.RemovePort(portToRemove);
                currentPorts.RemoveAt(currentPorts.Count - 1);
            }
        }

        // Primero pedimos a Blazor que renderice los nuevos componentes de puerto
        node.Refresh();
        StateHasChanged();

        // Esperamos un poco más para asegurar que el DOM está listo
        await Task.Delay(50);

        // Forzamos a cada puerto a recalcular sus dimensiones (esto llama a UpdateDimensions en PortRenderer)
        foreach (var port in node.Ports)
        {
            port.Initialized = false;
            port.Refresh();
        }

        // Refrescamos el diagrama para que se entere de las nuevas posiciones
        _diagram.Refresh();
    }

}