@using Blazor.Diagrams.Core.Models.Base;
@inject DialogService DialogService



<foreignObject width="150" height="100">
    <div class="LinkSettingsControl">
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">

                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Condición"></RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Icon="edit_note" Size="ButtonSize.ExtraSmall" 
                                  Variant="Variant.Outlined" Click="EditCondition"/>
                    <RadzenButton Icon="delete_forever" Size="ButtonSize.ExtraSmall" 
                                  Variant="Variant.Outlined" Click="DeleteCondition"/>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </div>
</foreignObject>

@code
{
    [Parameter] public LinkSettingsControl Control { get; set; } = null!;

    [Parameter] public BaseLinkModel Model { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }


    private void DeleteCondition()
    {
        Control.DeleteCondition();
    }
    async Task EditCondition()
    {
        var result = await DialogService.OpenAsync("Editar condición", ds =>
            @<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">
                <RadzenText Text="Nombre"/>
                <RadzenTextBox/>
                <RadzenText Text="Comando acción"/>
                <RadzenTextBox/>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Ok" Click="() => ds.Close(true)" Style="width: 80px;"/>
                    <RadzenButton Text="Cancel" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light"/>
                </RadzenStack>
            </RadzenStack>);
        Control.EditCondition();
    }
}