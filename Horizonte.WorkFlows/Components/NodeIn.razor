<style>

    .node {
        width: 300px;
        padding: 1rem !important;
        position: relative;
        border-radius: var(--rz-border-radius);
        box-shadow: var(--rz-shadow-5);
    }
    .node h5 {
        margin-top: 0;
        color: var(--rz-text-color);
        font-weight: var(--rz-font-weight-bold);
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .node .diagram-port {
        position: absolute;
        width: 12px;
        height: 12px;
        background-color: var(--rz-primary);
        border: 2px solid var(--rz-base-100);
        border-radius: 50%;
        cursor: crosshair;
        z-index: 10;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .node .diagram-port:hover {
        transform: scale(1.4);
        background-color: var(--rz-secondary);
    }

    .node .diagram-port.top {
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
    }

    .node .diagram-port.bottom {
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
    }

    .node .diagram-port.left {
        left: -6px;
        top: 50%;
        transform: translateY(-50%);
    }

    .node .diagram-port.right {
        right: -6px;
        top: 50%;
        transform: translateY(-50%);
    }

    .node .port-container .diagram-port.top,
    .node .port-container .diagram-port.bottom,
    .node .port-container .diagram-port.left,
    .node .port-container .diagram-port.right {
        top: 0;
        left: 0;
        right: auto;
        bottom: auto;
        transform: translate(-50%, -50%);
    }

    .node .port-container {
        position: absolute;
        width: 0;
        height: 0;
    }

</style>
<RadzenCard class="node rz-background-color-primary-lighter">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Class="rz-mb-2">
        <RadzenIcon Icon="login" IconColor="var(--rz-primary)" />
    </RadzenStack>

    <RadzenLabel Text="Nombre" Style="font-size: 0.8rem; margin-top: 0.5rem;" />
    <RadzenTextBox @bind-Value="Node.Node.Name" Placeholder="Nombre del nodo" Style="width: 100%; margin-bottom: 0.5rem;"></RadzenTextBox>

    <RadzenLabel Text="Acción de comando" Style="font-size: 0.8rem;" />
    <RadzenTextBox @bind-Value="Node.Node.CommandAction" Placeholder="Command Action" Style="width: 100%; margin-bottom: 0.5rem;"></RadzenTextBox>
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port"/>
    }
</RadzenCard>

@code {
    [Parameter] public NodeInModel Node { get; set; } = null!;
}