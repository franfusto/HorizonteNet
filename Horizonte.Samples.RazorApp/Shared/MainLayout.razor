
@inject IHContext Context
@inherits LayoutComponentBase

<PageTitle>Horizonte.Samples.RazorApp</PageTitle>

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="AlternateSidebar" />
            <RadzenLabel Text="@_title" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@_sidebar1Expanded">
        <NavMenu/>
    </RadzenSidebar>
    <RadzenBody>
            @Body
    </RadzenBody>
    <RadzenFooter>

    </RadzenFooter>
</RadzenLayout>

<RadzenComponents />

@code {
    string _title = String.Empty;
    protected override void OnInitialized()
    {
        _title = Context.Get<RazorAppConfig>()?.Title ?? "Horizonte Razor App Sample"; 
        base.OnInitialized();
    }

    bool _sidebar1Expanded = true;

    void AlternateSidebar()
    {
        _sidebar1Expanded = !_sidebar1Expanded;
    }
}


