@page "/counter"

<PageTitle>Counter</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start">

    <RadzenText TextStyle="TextStyle.H4" Text="Counter"></RadzenText>

    <RadzenButton Text="Click me" Click="IncrementCount" ButtonStyle="ButtonStyle.Danger"></RadzenButton>

    <RadzenText TextStyle="TextStyle.Body1" Text=@($"Current count: {currentCount}")></RadzenText>

</RadzenStack>


@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

}