<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageTags>experimental;preview</PackageTags>
    </PropertyGroup>




    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>


    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
      <ProjectReference Include="..\Horizonte.Extensions.Interactive\Horizonte.Extensions.Interactive.csproj" />
      <ProjectReference Include="..\Horizonte\Horizonte.csproj" />
      <ProjectReference Include="..\AdminUi.Components\AdminUi.Components.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectReferences)' == 'false'">
        <PackageReference Include="Horizonte.Extensions.Interactive" Version="$(InternalPackageVersion)"/>
        <PackageReference Include="Horizonte" Version="$(InternalPackageVersion)"/>
        <PackageReference Include="AdminUi.Components" Version="$(InternalPackageVersion)"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BlazorMonaco" Version="3.4.0" />
    </ItemGroup>

</Project>
