@using Horizonte.Extensions.Interactive
@using Radzen
@using Radzen.Blazor
@inject IhContext Context
@inject DialogService DialogService
@inject IhAssemblyManager AssemblyManager
@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages
@using Horizonte.Interfaces
@using Horizonte.Scripts.Components
@using Horizonte.Scripts.Config


@if (Script != null)
{
    <RadzenStack Gap="1rem" Style="flex-grow: 1;">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" Class="rz-m-0">Editar Script: @Script.Name</RadzenText>
                @if (!string.IsNullOrEmpty(Script.Description))
                {
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0 rz-text-secondary">(@Script.Description)</RadzenText>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@OnSave" Tooltip="Guardar cambios" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@OnDelete" Tooltip="Eliminar script" />
                    <RadzenButton Icon="build" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@OnCompile" Tooltip="Compilar script" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>

        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Nombre" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@Script.Name" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="5">
                <RadzenFormField Text="Descripción" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@Script.Description" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3" Class="rz-display-flex rz-align-items-center">
                <RadzenCheckBox @bind-Value="@Script.Active" Name="LoadOnStart" />
                <RadzenLabel Text="Activo" Component="LoadOnStart" Class="rz-ms-2" />
            </RadzenColumn>
        </RadzenRow>

        <br/>
        
        <MonacoEditor @bind-Value="@Script.CodeText" Language="csharp" />

    </RadzenStack>
}
else
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
        <RadzenText TextStyle="TextStyle.Subtitle1">Seleccione un script para editar o cree uno nuevo.</RadzenText>
    </div>
}

@code {
    [Parameter]
    public ScriptDef? Script { get; set; }

    private string? _lastScriptId;

    protected override async Task OnParametersSetAsync()
    {
        if (Script != null && Script.Id != _lastScriptId)
        {
            _lastScriptId = Script.Id;
            // Forzar actualización si es necesario, aunque MonacoEditor ya debería detectarlo por el cambio en Value
        }
        await base.OnParametersSetAsync();
    }

    [Parameter]
    public EventCallback OnScriptDeleted { get; set; }

    [Parameter]
    public EventCallback OnScriptSaved { get; set; }

    private async Task OnSave()
    {
        try
        {
            if (Script == null) return;

            var config = Context.Get<ScriptsConfig>() ?? new ScriptsConfig();
            
            var existingScript = config.Scripts.FirstOrDefault(s => s.Id == Script.Id);
            if (existingScript != null)
            {
                existingScript.Name = Script.Name;
                existingScript.Description = Script.Description;
                existingScript.Code = Script.Code;
                existingScript.Active = Script.Active;
            }
            else
            {
                config.Scripts.Add(Script);
            }

            Context.Update(config);
            await OnScriptSaved.InvokeAsync();
            await DialogService.Alert("Script guardado correctamente", "Éxito");
        }
        catch (Exception ex)
        {
            await DialogService.Alert($"Error al guardar: {ex.Message}", "Error");
        }
    }

    private async Task OnDelete()
    {
        if (Script != null)
        {
            var confirm = await DialogService.Confirm($"¿Estás seguro de que quieres eliminar el script '{Script.Name}'?", "Confirmar");
            if (confirm == true)
            {
                var config = Context.Get<ScriptsConfig>();
                if (config != null)
                {
                    var scriptToRemove = config.Scripts.FirstOrDefault(s => s.Id == Script.Id);
                    if (scriptToRemove != null)
                    {
                        config.Scripts.Remove(scriptToRemove);
                        Context.Update(config);
                        await OnScriptDeleted.InvokeAsync();
                    }
                }
            }
        }
    }

    private async Task OnCompile()
    {
        if (Script == null) return;
        var res = await Script.Compile(AssemblyManager);
        if (res.Errors.Count() == 0)
        {
            await DialogService.Alert("Script compilado correctamente", "Éxito");
        }
        else
        {
            var errors = string.Join("\n", res.Errors);
            await DialogService.Alert($"Errores de compilación:\n{errors}", "Error");
        }
    }


}
