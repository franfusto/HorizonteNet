@using Microsoft.DotNet.Interactive.Documents.Jupyter
@using Microsoft.DotNet.Interactive.Documents
@using Horizonte.Scripts.Components
@using System.Text
@using System.Text.Json
@using Horizonte.Extensions.Interactive
@using Microsoft.DotNet.Interactive.Commands
@using Microsoft.DotNet.Interactive.Events
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using System.Linq
@using Horizonte.Interfaces
@using Microsoft.DotNet.Interactive
@using Microsoft.DotNet.Interactive.Formatting
@inject IJSRuntime JSRuntime
@inject IhContext Context
@inject ILogger log
@inject DialogService DialogService
@inject IServiceProvider ServiceProvider
@inject IHGesCom GesCom

<style>
    .markdown-container h1 {
        font-size: 2.25rem !important;
        margin-top: 1rem;
        font-weight: bold;
    }

    .markdown-container h2 {
        font-size: 2.00rem !important;
        margin-top: 0.8rem;
    }

    .markdown-container h3 {
        font-size: 1.75rem !important;
    }

    .markdown-container h4 {
        font-size: 1.50rem !important;
    }
    .markdown-container h5 {
        font-size: 1.25rem !important;
    }
    .markdown-container h6 {
        font-size: 1rem !important;
    }

    /* Ajuste de márgenes para que no ocupe tanto espacio */
    .markdown-container p {
        margin-bottom: 0.5rem;
    }

    .cell-container {
        position: relative;
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-style: solid;
        border-width: 1px;
    }

    .cell-handle {
        display: flex;
        flex-direction: row;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
        justify-content: flex-start;
        align-items: center;
    }

    .output-card-container {
        margin-top: 0.5rem;
    }
</style>

@if (Notebook != null)
{

    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
        <RadzenCard>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenText Text="Kernel" TextStyle="TextStyle.DisplayH6" Class="rz-m-0"/>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenDropDown TValue="KernelItem" Data="@_kernelConfig?.KernelItems" TextProperty="Name"
                                        @bind-Value="@_selectedKernel" Placeholder="Kernel" Style="width: 200px;"/>
                        <RadzenButton Icon="play_arrow" Click="@(() => LoadKernel(_selectedKernel))"
                                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                      Tooltip="Cargar Kernel"
                                      Disabled="@(_selectedKernel == null)"/>
                    </RadzenStack>
                </RadzenStack>
                @if (Notebook != null)
                {
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                        <RadzenText Text="Documento" TextStyle="TextStyle.DisplayH6" Class="rz-m-0"/>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                            <RadzenButton Icon="get_app" Click="@DownloadNotebook"
                                          ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"/>
                            <RadzenButton Icon="save_as" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                          Click="SaveAs"/>
                            <RadzenButton Icon="cleaning_services" ButtonStyle="ButtonStyle.Primary"
                                          Variant="Variant.Outlined"
                                          Click="CleanOutput" Disabled="@(!_isKernelLoaded)"/>
                            <RadzenButton Icon="fast_forward" ButtonStyle="ButtonStyle.Primary"
                                          Variant="Variant.Outlined"
                                          Click="RunAll" Disabled="@(!_isKernelLoaded)"/>
                        </RadzenStack>
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Gap="1rem">
            @foreach (var element in Notebook.Elements)
            {
                <div class="cell-container rz-border-radius rz-border-primary-lighter">
                    @if (element is InteractiveDocumentElement cellElement)
                    {
                        <div class="cell-handle rz-border-color-lighter-bottom">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                         AlignItems="AlignItems.Center">
                                <RadzenButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall"
                                              Variant="Variant.Outlined"
                                              Click="@(() => MoveUp(cellElement))" Tooltip="Subir"/>
                                <RadzenButton Icon="arrow_downward" Size="ButtonSize.ExtraSmall"
                                              Variant="Variant.Outlined"
                                              Click="@(() => MoveDown(cellElement))" Tooltip="Bajar"/>
                                <RadzenButton Icon="code_blocks" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@(() => InsertCell(cellElement, true))"
                                              Tooltip="Insertar bloque de cóigo"/>
                                <RadzenButton Icon="markdown" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@(() => InsertCell(cellElement, false))"
                                              Tooltip="Insertar markdown"/>
                                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@(async () => await DeleteCell(cellElement))" Tooltip="Borrar"/>
                            </RadzenStack>
                        </div>

                        <RadzenStack Gap="0.5rem">
                            @if (cellElement.KernelName == "markdown")
                            {
                                <div class="markdown-container">
                                    <MarkDownEditor Cell="cellElement"/>
                                </div>
                            }
                            else
                            {
                                <CodeEditor Cell="cellElement" Disabled="@(!_isKernelLoaded)"
                                            OnRun="@(() => RunCell(cellElement))"/>
                                @if (cellElement.Outputs != null && cellElement.Outputs.Any())
                                {
                                    <div class="outputs">
                                        @foreach (var output in cellElement.Outputs)
                                        {
                                            if (output is WidgetDerRenderElement rederit)
                                            {
                                                @RenderWidgetDef(rederit.WidgetDef)
                                            }
                                            else if (output is TextElement textElement)
                                            {
                                                <RadzenText>
                                                    @((MarkupString)textElement.Text)
                                                </RadzenText>
                                            }
                                            else
                                            {
                                                <RadzenCard
                                                    class="rz-background-color-background rz-border-color-lighter rz-p-2 rz-mt-2">
                                                    @((MarkupString)output.ToDisplayString())
                                                </RadzenCard>
                                            }
                                        }
                                    </div>
                                }
                            }
                        </RadzenStack>
                    }

                </div>
            }

        </RadzenStack>
    </RadzenStack>
}
else
{
    <RadzenStack Class="rz-p-4">
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @if (IsLoading)
            {
                <text>Cargando notebook...</text>
            }
            else
            {
                <text>Seleccione un documento para visualizar</text>
            }
        </RadzenAlert>
    </RadzenStack>
}


@code {
    [Parameter] public InteractiveDocument? Notebook { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<InteractiveDocument> OnSaveRequest { get; set; }

    private KernelConfig? _kernelConfig;
    private KernelItem? _selectedKernel;
    private InteractiveDocumentElement? _currentCell;
    private CompositeKernel? _kernel;
    private bool _isKernelLoaded;
    private bool _isolated = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("fixMarkdownLinks");
        await base.OnAfterRenderAsync(firstRender);
    }

    // page 
    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    private void Get()
    {
        _kernelConfig = Context.Get<KernelConfig>() ?? new KernelConfig();
    }

    private RenderFragment? RenderWidgetDef(WidgetDef widgetDef)
    {
        try
        {
            var renderFragment = GesCom.RunCommand<RenderFragment>("HorizonteGui_RenderWidget", new object[] { widgetDef });
            return renderFragment;
        }
        catch (Exception e)
        {
            log.LogError(e.ToString());
        }

        return null;
    }
    // kernel


    private async Task LoadKernel(KernelItem? kernelItem)
    {
        if (kernelItem == null) return;
        _isolated = kernelItem.Name != "Default";
        _isKernelLoaded = false;
        if (_kernel != null)
        {
            _kernel.Dispose();
            _kernel = null;
        }

        var options = new KernelOptions();
        options.Isolated = _isolated; // refactorizar, se ha añadido isolateda a las opciones del kernel
        _kernel = await options.BuildKernelAsync(ServiceProvider);

        _kernel.KernelEvents.Subscribe(OnKernelEvent);
        _isKernelLoaded = true;
    }

    private void OnKernelEvent(KernelEvent evt)
    {
        if (_currentCell == null)
            return;

        switch (evt)
        {
            case StandardOutputValueProduced stdout:
                AddOutput("text/plain", stdout.FormattedValues.First().Value);
                break;

            case StandardErrorValueProduced stderr:
                AddOutput("text/plain", stderr.FormattedValues.First().Value);
                break;

            case ReturnValueProduced returnValue:
                if (returnValue.Value?.GetType() == typeof(WidgetDef))
                {
                    AddWidgetDefOutput((WidgetDef)returnValue.Value);
                    break;
                }

                AddOutput(
                    returnValue.FormattedValues.First().MimeType,
                    returnValue.FormattedValues.First().Value
                );
                break;

            case DisplayedValueProduced display:
                AddOutput(
                    display.FormattedValues.First().MimeType,
                    display.FormattedValues.First().Value
                );
                break;

            case CommandFailed failed:
                AddOutput("text/plain", failed.Message);
                break;
        }
    }

    private void AddWidgetDefOutput(WidgetDef widgetDef)
    {
        try
        {
            var output = new WidgetDerRenderElement(widgetDef);
            _currentCell!.Outputs.Add(output);
        }
        catch (Exception e)
        {
            log.LogError(e.ToString());
            AddOutput("text/plain", "Widget no disponible");
        }
    }

    private void AddOutput(string mimeType, object value)
    {
        var output = new TextElement(value.ToString());

        _currentCell!.Outputs.Add(output);

        InvokeAsync(StateHasChanged);
    }


    // actions

    private async Task DownloadNotebook()
    {
        if (Notebook == null) return;

        try
        {
            string contentString = Microsoft.DotNet.Interactive.Documents.Jupyter.Notebook.ToJupyterJson(Notebook);

            var fileName = "notebook_editado.ipynb";
            byte[] bytes = Encoding.UTF8.GetBytes(contentString);
            await JSRuntime.InvokeAsync<object>(
                "saveAsFile",
                fileName,
                Convert.ToBase64String(bytes)
            );
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error al descargar: {e.Message}");
        }
    }

    private async Task RunCell(InteractiveDocumentElement codeCell)
    {
        if (!_isKernelLoaded || _kernel == null) return;

        codeCell.Outputs.Clear();
        _currentCell = codeCell;

        await InvokeAsync(StateHasChanged);

        var command = new SubmitCode(codeCell.Contents, codeCell.KernelName);

        await _kernel.SendAsync(command);

        _currentCell = null;
    }

    private async Task RunAll()
    {
        if (Notebook == null) return;

        foreach (var element in Notebook.Elements)
        {
            if (element is InteractiveDocumentElement codeCell)
            {
                await RunCell(codeCell);
            }
        }
    }

    private async Task CleanOutput()
    {
        if (Notebook == null) return;

        foreach (var element in Notebook.Elements)
        {
            if (element is InteractiveDocumentElement codeCell)
            {
                codeCell.Outputs.Clear();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAs()
    {
        if (Notebook != null)
        {
            await CleanOutput();
            await OnSaveRequest.InvokeAsync(Notebook);
        }
    }

    private void MoveUp(InteractiveDocumentElement element)
    {
        if (Notebook == null) return;
        var index = Notebook.Elements.IndexOf(element);
        if (index > 0)
        {
            Notebook.Elements.RemoveAt(index);
            Notebook.Elements.Insert(index - 1, element);
            StateHasChanged();
        }
    }

    private void MoveDown(InteractiveDocumentElement element)
    {
        if (Notebook == null) return;
        var index = Notebook.Elements.IndexOf(element);
        if (index < Notebook.Elements.Count - 1)
        {
            Notebook.Elements.RemoveAt(index);
            Notebook.Elements.Insert(index + 1, element);
            StateHasChanged();
        }
    }

    private async Task DeleteCell(InteractiveDocumentElement element)
    {
        if (Notebook == null) return;

        var confirm = await DialogService.Confirm("¿Está seguro de que desea eliminar esta celda?", "Confirmar eliminación", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });

        if (confirm == true)
        {
            Notebook.Elements.Remove(element);
            StateHasChanged();
        }
    }

    private void InsertCell(InteractiveDocumentElement currentElement, bool codecell)
    {
        if (Notebook == null) return;
        var index = Notebook.Elements.IndexOf(currentElement);
        InteractiveDocumentElement newCell;

        if (codecell)
        {
            newCell = new InteractiveDocumentElement("", "csharp");
        }
        else
        {
            newCell = new InteractiveDocumentElement("", "markdown");
        }

        Notebook.Elements.Insert(index + 1, newCell);
        StateHasChanged();
    }

}
