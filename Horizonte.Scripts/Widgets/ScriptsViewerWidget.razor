@using Horizonte.Extensions.Interactive
@using Radzen
@using Radzen.Blazor
@inject IHContext Context
@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="rz-p-4" Style="height: 100%;">
    <RadzenCard Style="width: 300px; min-width: 300px; display: flex; flex-direction: column;">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" Class="rz-m-0">Scripts</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@OnAddScript" Tooltip="Añadir nuevo script" />
            </RadzenStack>
        </RadzenStack>
        
        <RadzenTree Change="@OnTreeChange" Data="@_config.Scripts" Style="flex-grow: 1; overflow: auto;">
            <RadzenTreeLevel TextProperty="Name" HasChildren="@(n => false)" />
        </RadzenTree>
    </RadzenCard>

    <RadzenCard Style="flex-grow: 1; display: flex; flex-direction: column;">
        <ScriptsViewer Script="@_selectedScript" OnScriptDeleted="@OnScriptDeleted" OnScriptSaved="@OnScriptSaved" />
    </RadzenCard>
</RadzenStack>

@code {
    private ScriptsConfig _config = new();
    private ScriptDef? _selectedScript;

    protected override void OnInitialized()
    {
        LoadConfig();
        base.OnInitialized();
    }

    private void LoadConfig()
    {
        _config = Context.Get<ScriptsConfig>() ?? new ScriptsConfig();
    }

    private void OnTreeChange(TreeEventArgs args)
    {
        _selectedScript = args.Value as ScriptDef;
    }

    private void OnAddScript()
    {
        var newScript = new ScriptDef { Id = Guid.NewGuid().ToString(), Name = "Nuevo Script" };
        newScript.CodeText = "// Escribe tu código aquí";
        _config.Scripts.Add(newScript);
        _selectedScript = newScript;
    }



    private void OnScriptDeleted()
    {
        _selectedScript = null;
        LoadConfig();
        StateHasChanged();
    }

    private void OnScriptSaved()
    {
        LoadConfig();
        StateHasChanged();
    }
}