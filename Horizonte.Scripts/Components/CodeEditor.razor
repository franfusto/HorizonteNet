@using Blazor.Monaco
@using Microsoft.DotNet.Interactive.Documents
@using  Microsoft.AspNetCore.Components.Web
 


<RadzenStack Gap="0.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Icon="play_arrow" 
                      ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Outlined" 
                      Size="ButtonSize.Small" 
                      Disabled="@Disabled"
                      Click="@OnRun" />
    </RadzenStack>


<RadzenTextArea @bind-Value="Cell.Contents" Style="width: 100%; font-family: monospace;" Rows="5" />
@***
    <MonacoEditor 
        Language="Language.CSharp"
        ScriptContent="@Cell.Contents"/>

***@

</RadzenStack>

@code {
    [Parameter]
    public InteractiveDocumentElement Cell { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnRun { get; set; }
    private string Codigo = @"public class Test
{
    public void Run()
    {
        Console.WriteLine(""Hola"");
    }
}";
}