
@using Horizonte.Interfaces
@using Horizonte.PorcupineMod
@inject IhContext Context
<RadzenCard style="width: 100%" >
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Porcupine"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
            <RadzenButton Text="Grabar" Variant="Variant.Outlined" Icon="save" Size="ButtonSize.Small"
                          Click="Update"></RadzenButton>
        </div>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical">
        <div>
            <RadzenText Text="AccessKey"/>
            <CredentialSelector @bind-value="@_config.AccessKey"/>
        </div>
        

    </RadzenStack>
    <br/>
</RadzenCard>

@code {
    private PorcupineConfig _config = new PorcupineConfig();
    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }
    private void Get()
    {
        _config = Context.Get<PorcupineConfig>() ?? new PorcupineConfig();
    }
    private void Update()
    {
        Context.Update(_config);
    }   
}