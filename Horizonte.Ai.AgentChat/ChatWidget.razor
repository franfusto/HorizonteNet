@using System.ComponentModel
@using Horizonte.Ai.AgentChat.Entities
@using Horizonte.Extension.AiWorkFlows
@using Horizonte.Extension.AiWorkFlows.Tools
@using Microsoft.Agents.AI
@using Microsoft.Extensions.AI
@using Microsoft.Extensions.Logging
@using OpenAI
@using OpenAI.Chat
@using OpenAI.Realtime
@using AgentResponse = Microsoft.Agents.AI.AgentResponse
@using ChatResponseFormat = Microsoft.Extensions.AI.ChatResponseFormat
@inject IHGesCom GesCom
@inject IHCredManager CredManager
@inject IHorizonteEnv HorizonteEnv
@inject DialogService DialogService
@inject IHContext Context
@inject  ILogger<ChatWidget> Logger

<RadzenStack Style="width: 100%; height: 100%;" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">

    <RadzenStack Style="width: 100%" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenTextBox Style="width: 100%" @bind-Value="@_prompt" Placeholder="Escribe un mensaje..." @onkeyup="@HandleKeyUp" />
        <RadzenButton IsBusy="@_busy" Icon="send" Click="@Send" />
        <RadzenButton Icon="delete" Click="@ClearChat" ButtonStyle="ButtonStyle.Light" />
    </RadzenStack>

    <RadzenListBox Style="width: 100%; flex-grow: 1;" TValue="ChatElement" @bind-Value="@_selectedChatElement" Data="@_chatlist">
        <Template>
            @{
                var item = context as ChatElement;
            }
            <RadzenCard Style="width: 100%; margin: 5px 0;">
                <RadzenStack AlignItems="AlignItems.Center"
                             JustifyContent="@(item?.OrientationLeft == true ? JustifyContent.Start : JustifyContent.End)"
                             Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="@item?.IconName" />
                    <RadzenText Text="@(item?.OrientationLeft == true ? "Usuario" : "Agente")" TextStyle="TextStyle.Caption" />
                </RadzenStack>
                <RadzenMarkdown Style="width: 100%">
                    @((MarkupString)(item?.Text.Replace(Environment.NewLine, "<br/>") ?? string.Empty))
                </RadzenMarkdown>
                @if (item?.RenderFragment != null)
                {
                    <div class="mt-2">
                        @item.RenderFragment
                    </div>
                }
            </RadzenCard>
        </Template>
    </RadzenListBox>

    @if (_busy)
    {
        <RadzenButton Text="Cancelar" Icon="cancel" Click="@Cancel" ButtonStyle="ButtonStyle.Danger" />
    }
</RadzenStack>

@code
{
    private const string AGENT_OUTPUT_FORMAT = @"
Serializa la respuesta en Output usando el siguiente formato para la salida estructurada:
{
  'type': 'object',
  'title': 'AgentResponse',
  'properties': {
    'Output': {
      'type': 'object',
      'title': 'Output',
      'description': 'Representa los datos de salida estructurados del agente.',
      'properties': {
        'Response': {
          'type': 'string',
          'description': 'Tu respuesta para el usuario.'
        },
        'Widget': {
          'type': 'string',
          'description': 'El nombre del comando que genera el widget en la interfaz gráfica.'
        },
        'Error': {
          'type': 'string',
          'description': 'Mensaje de error si ocurre alguno.'
        }
      },
      'required': ['Response'],
      'additionalProperties': false
    }
  },
  'required': ['Output'],
  'additionalProperties': false
}
";

    private AIAgent? _agent;
    private AgentSession? _session;
    private bool _busy;
    private List<ChatElement> _chatlist = new();
    private ChatElement _selectedChatElement = new();
    private string _prompt = string.Empty;
    private CancellationTokenSource? _cts;
    private AgentChatConfig _chatconfig = new();

    protected override async Task OnInitializedAsync()
    {
        _chatconfig = Context.Get<AgentChatConfig>() ?? new AgentChatConfig();
        await SetUpAgent();
    }

    private async Task SetUpAgent()
    {
        OpenAIClient client = _chatconfig.ClientDef.GetClient(CredManager);

        _chatconfig.AgentDef.Instructions += AGENT_OUTPUT_FORMAT;

        HCommandToolSet toolSet = new(HorizonteEnv, client, _chatconfig.AgentDef.EmbedderModel);
        IList<AITool> tools = new[]
        {
            toolSet.GetSystemTime(),
            toolSet.RunCommand(),
            toolSet.QueryVectorStore()
        };

        _agent = _chatconfig.AgentDef.WhithTools(tools).Build(client);
        _session = await _agent.CreateSessionAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Send();
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            AddChatMessage("El mensaje no puede estar vacío.", "warning", true);
            return;
        }

        if (_agent == null || _session == null)
        {
            AddChatMessage("El agente no está inicializado.", "error", false);
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        AddChatMessage(_prompt, "person", true);

        _busy = true;
        string currentPrompt = _prompt;
        _prompt = string.Empty;

        try
        {
            var result = await _agent.RunAsync(currentPrompt, _session, null, _cts.Token);
            var responseElement = ProcessAgentResponse(result);
            _chatlist.Add(responseElement);
        }
        catch (OperationCanceledException)
        {
            AddChatMessage("Operación cancelada.", "info", false);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Error durante el procesamiento del mensaje");
            AddChatMessage("Ocurrió un error al procesar la solicitud.", "error", false);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddChatMessage(string text, string icon, bool isUser)
    {
        _chatlist.Add(new ChatElement
        {
            Text = text,
            IconName = icon,
            OrientationLeft = isUser
        });
    }

    private ChatElement ProcessAgentResponse(AgentResponse response)
    {
        var chatElement = new ChatElement
        {
            IconName = "smart_toy",
            OrientationLeft = false
        };

        try
        {
            var jsonResponse = response.ToString();
            var agentResponse = System.Text.Json.JsonSerializer.Deserialize<AgentChatResponse>(jsonResponse);

            if (agentResponse?.Output != null)
            {
                chatElement.Text = agentResponse.Output.Response ?? jsonResponse;

                if (!string.IsNullOrEmpty(agentResponse.Output.Widget))
                {
                    chatElement.RenderFragment = CreateWidgetRenderFragment(agentResponse.Output.Widget);
                }

                if (!string.IsNullOrEmpty(agentResponse.Output.Error))
                {
                    chatElement.Text = $"Error: {agentResponse.Output.Error}";
                    chatElement.IconName = "error";
                }
            }
            else
            {
                chatElement.Text = jsonResponse;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al deserializar la respuesta del agente");
            chatElement.Text = response.ToString();
        }

        return chatElement;
    }

    private RenderFragment CreateWidgetRenderFragment(string widgetCommandKey)
    {
        var command = GesCom.GetCommandList().FirstOrDefault(x => x.CommandKey == widgetCommandKey);
        if (command == null) return null;

        WidgetDef widgetDef;
        if (command.Roles.Contains("widget") || command.Roles.Contains("configpage"))
        {
            widgetDef = GesCom.RunCommand<WidgetDef>(widgetCommandKey);
        }
        else
        {
            var type = Type.GetType("Horizonte.AdminUi.HorizonteSettings.Components.ExecuteCommand, Horizonte.AdminUi.HorizonteSettings");
            if (type == null)
            {
                return builder => builder.AddMarkupContent(0, "<p>No se pudo cargar el tipo de widget proporcionado.</p>");
            }

            widgetDef = new WidgetDef
            {
                Type = type,
                Parameters = new Dictionary<string, object> { { "Command", command } }
            };
        }

        return GesCom.RunCommand<RenderFragment>("HorizonteGui_RenderWidget", new object[] { widgetDef })
               ?? (builder => builder.AddMarkupContent(0, "<p>Error al cargar el widget</p>"));
    }

    private async Task ClearChat()
    {
        if (_agent != null)
        {
            _session = await _agent.CreateSessionAsync();
        }
        _chatlist.Clear();
        _prompt = string.Empty;
    }

    private void Cancel()
    {
        _cts?.Cancel();
        _busy = false;
    }
}
