@using AdminUi.Components
@using Horizonte
@inject IHContext Context
<RadzenCard style="width: 100%" >
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="AEMET"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
            <RadzenButton Text="Grabar" Variant="Variant.Outlined" Icon="save" Size="ButtonSize.Small"
                          Click="Update"></RadzenButton>
        </div>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical">
        <div>
            <RadzenText Text="Url del servicio"/>
            <CredentialSelector @bind-value="_aemetConfig.BaseUrl"/>
        </div>
        <div>
            <RadzenText Text="API Key"/>
            <CredentialSelector @bind-value="_aemetConfig.ApiKey"/>
        </div>
       
    </RadzenStack>
    <br/>
</RadzenCard>

@code {
    AemetConfig _aemetConfig = new();

    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    private void Get()
    {
        _aemetConfig = Context.Get<AemetConfig>() ?? new AemetConfig();
    }

    private void Update()
    {
        Context.Update(_aemetConfig);
    }

}