<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <Title>AEMET sample module</Title>
        <Description>Example module for Horizonte.Net, which provides access to the AEMET meteorological service. Service key is required</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>


    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
      <ProjectReference Include="..\Horizonte\Horizonte.csproj" />
        <ProjectReference Include="..\Horizonte.AdminUi.Components\Horizonte.AdminUi.Components.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectReferences)' == 'false'">
        <PackageReference Include="Horizonte" Version="$(InternalPackageVersion)" />
        <PackageReference Include="Horizonte.AdminUi.Components" Version="$(InternalPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
      <None Update="README.md">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
</Project>
