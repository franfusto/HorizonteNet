@inject IHContext Context
@inject IhAssemblyManager AssemblyManager
<RadzenStack Orientation="Orientation.Vertical">
    <RadzenDataGrid @ref="_grid" AllowAlternatingRows="false" AllowFiltering="false" AllowPaging="false"
                    AllowSorting="false" 
                    EditMode="DataGridEditMode.Single" Data="_localDomains" TItem="DomainItem"
                    RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"  >
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Vertical">
                <RadzenText TextStyle="TextStyle.Subtitle1">Dominios</RadzenText>
                <RadzenButton Variant="Variant.Outlined" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@InsertRow"
                              Size="ButtonSize.ExtraSmall" Text="Añadir"/>
            </RadzenStack>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(DomainItem.Domain)" Title="Dominio">
                <EditTemplate Context="item">
                    <RadzenTextBox @bind-Value="item.Domain" Style="width: 100%"/>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Acciones ALC" TextAlign="TextAlign.Center" Width="180px">
                <Template Context="item">
                    @if (item.Domain != "Default")
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="file_download_off" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat"
                                          Size="ButtonSize.Small" Click="@(args => UnloadDomain(item))"
                                          ToolTip="Descargar (Unload)">
                            </RadzenButton>
                            <RadzenButton Icon="file_download" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat"
                                          Size="ButtonSize.Small" Click="@(args => LoadDomain(item))"
                                          ToolTip="Cargar (Load)">
                            </RadzenButton>
                            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                          Size="ButtonSize.Small" Click="@(args => ReloadDomain(item))"
                                          ToolTip="Recargar (Reload)">
                            </RadzenButton>
                        </RadzenStack>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="item" Filterable="false" Sortable="false" TextAlign="TextAlign.Right"
                                  Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="100px">
                <Template Context="item">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" Click="@(args => EditRow(item))"
                                  @onclick:stopPropagation="true">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" Click="@(args => DeleteRow(item))"
                                  @onclick:stopPropagation="true">
                    </RadzenButton>
                </Template>
                <EditTemplate Context="item">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" aria-label="Save" Click="@((args) => SaveRow(item))">
                    </RadzenButton>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" aria-label="Cancel"
                                  Click="@((args) => CancelEdit(item))">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat"
                                  Shade="Shade.Lighter"
                                  Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" aria-label="Delete"
                                  Click="@(args => DeleteRow(item))">
                    </RadzenButton>
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {

    [Parameter] public List<string> Domains { get; set; } = new List<string>();
    
    public class DomainItem
    {
        public string Domain { get; set; } = string.Empty;
    }

    private RadzenDataGrid<DomainItem> _grid = new RadzenDataGrid<DomainItem>();
    private List<DomainItem> _localDomains = new();
    
    protected override void OnParametersSet()
    {
        _localDomains = Domains.Select(x => new DomainItem { Domain = x }).ToList();
        base.OnParametersSet();
    }

    private void Sync()
    {
        Domains.Clear();
        Domains.AddRange(_localDomains.Select(x => x.Domain));
    }

    async Task InsertRow()
    {
        var item = new DomainItem()
        {
            Domain = "Default"
        };
        await _grid.InsertRow(item);
    }

    void OnUpdateRow(DomainItem item)
    {
        Sync();
        _grid.Reload();
    }

    void OnCreateRow(DomainItem item)
    {
        _localDomains.Add(item);
        Sync();
    }

    async Task EditRow(DomainItem item)
    {
        await _grid.EditRow(item);
    }

    async Task SaveRow(DomainItem item)
    {
        await _grid.UpdateRow(item);
    }

    void CancelEdit(DomainItem item)
    {
        _grid.CancelEditRow(item);
        _grid.Reload();
    }

    async Task DeleteRow(DomainItem item)
    {
        _localDomains.Remove(item);
        Sync();
        await _grid.Reload();
    }

    private void UnloadDomain(DomainItem item)
    {
        // TODO: Implementar Unload en AssemblyManager
    }

    private void LoadDomain(DomainItem item)
    {
        // TODO: Implementar Load en AssemblyManager
    }

    private void ReloadDomain(DomainItem item)
    {
        // TODO: Implementar Reload en AssemblyManager
    }
}
