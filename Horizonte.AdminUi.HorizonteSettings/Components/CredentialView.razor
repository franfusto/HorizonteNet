@inject DialogService DialogService
<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body1">Valor de la credencial para <b>@Key</b>:</RadzenText>
    <RadzenTextArea Value="@Value" ReadOnly="true" Rows="5" style="width: 100%" />
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Text="Cerrar" Click="@(() => DialogService.Close())" ButtonStyle="ButtonStyle.Light" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public string Key { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; }= string.Empty;
}
