<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body1">Establecer valor para <b>@Key</b>:</RadzenText>
    <RadzenTextArea @bind-Value="@Value" Rows="5" style="width: 100%" />
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Cancelar" Click="@(() => DialogService.Close(null))" ButtonStyle="ButtonStyle.Light" />
        <RadzenButton Text="Guardar" Click="@(() => DialogService.Close(Value))" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>
</RadzenStack>

@code {
    [Inject] DialogService DialogService { get; set; }
    [Parameter] public string Key { get; set; }
    [Parameter] public string Value { get; set; }
}
