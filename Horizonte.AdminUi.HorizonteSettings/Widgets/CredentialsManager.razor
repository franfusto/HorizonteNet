@using Horizonte
@using Horizonte.AdminUi.HorizonteSettings.Components
@inject IHCredManager Credmanager
@inject DialogService DialogService
<RadzenCard style="width: 100%">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Gestor De Credenciales"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="add" Size="ButtonSize.Small" Click="AddCredential" class="rz-me-1"></RadzenButton>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
        </div>
    </RadzenStack>
    <br/>
    <RadzenDataGrid Data="@keys" TItem="string" AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenDataGridColumn TItem="string" Property="this" Title="Key">
                <Template Context="key">
                    @key
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="string" Context="key" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
                <Template Context="key">
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(() => ShowCredential(key))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-ms-1" Click="@(() => EditCredential(key))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-ms-1" Click="@(() => DeleteCredential(key))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <br/>
</RadzenCard>

@code {

    List<string> keys = new List<string>();

    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    private void Get()
    {
        keys = Credmanager.KeyList.ToList();
    }

    private async Task AddCredential()
    {
        var result = await DialogService.OpenAsync<CredentialCreate>("Añadir Nueva Credencial",
            null,
            new DialogOptions() { Resizable = true, Draggable = true });

        if (result is CredentialCreate.CredentialResult credential)
        {
            Credmanager.SetCredential(credential.Key, credential.Value);
            Get();
        }
    }

    private async Task ShowCredential(string key)
    {
        var value = Credmanager.GetCredential(key);
        await DialogService.OpenAsync<CredentialView>($"Visualizar Credencial",
            new Dictionary<string, object> { { "Key", key }, { "Value", value } },
            new DialogOptions() { Resizable = true, Draggable = true });
    }

    private async Task EditCredential(string key)
    {
        var value = Credmanager.GetCredential(key);
        var result = await DialogService.OpenAsync<CredentialEdit>($"Editar Credencial",
            new Dictionary<string, object> { { "Key", key }, { "Value", value } },
            new DialogOptions() { Resizable = true, Draggable = true });

        if (result != null)
        {
            Credmanager.SetCredential(key, (string)result);
            Get();
        }
    }

    private async Task DeleteCredential(string key)
    {
        var confirm = await DialogService.Confirm($"¿Está seguro de que desea eliminar la credencial '{key}'?", "Eliminar Credencial", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });
        if (confirm == true)
        {
            Credmanager.DeleteCredential(key);
            Get();
        }
    }
}

