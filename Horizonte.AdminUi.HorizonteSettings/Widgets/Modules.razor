@using Horizonte.Interfaces
@inject IhContext Context
@inject DialogService DialogService
<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.DisplayH5" Text="Módulos"></RadzenText>
        <div>
            <RadzenButton Variant="Variant.Outlined" Icon="sync" Size="ButtonSize.Small" Click="Get"></RadzenButton>
            <RadzenButton Text="Grabar" Variant="Variant.Outlined" Icon="save" Size="ButtonSize.Small" Click="Update"></RadzenButton>
        </div>
    </RadzenStack>
</RadzenCard>
    <br/>

    <DomainsGrid Domains="_domains" @ref="_domainsGrid"/>
    <ModulesGrid ModuleSettings="_modules" Domains="_domains" @ref="_modulesGrid"/>
    <NugetServersGrid NugetServersSettings="_nugetServers" @ref="_nugetServersGrid"/>
    <NugetFoldersGrid NugetFolderSettings="_nugetFolders" @ref="_nugetFoldersGrid"/>
    <FrameworkPrioritiesGrid FrameworkPriorities="_frameworkPriorities" @ref="_frameworkPrioritiesGrid"/>
    <ForcedPackagesGrid ForcedPackages="_forcedPackages" Domains="_domains" @ref="_forcedPackagesGrid"/>

@code {
    
    private ModulesSettings _modulesSettings = new ModulesSettings();
    private ModulesGrid _modulesGrid = new();
    private List<ModulesSettingsItem> _modules = new();
    private DomainsGrid _domainsGrid = new();
    private List<string> _domains = new();
    private NugetServersGrid _nugetServersGrid = new();
    private List<NugetServerItem> _nugetServers = new ();
    private NugetFoldersGrid _nugetFoldersGrid = new();
    private List<NugetFolderItem> _nugetFolders = new ();
    private FrameworkPrioritiesGrid _frameworkPrioritiesGrid = new();
    private List<string> _frameworkPriorities = new();
    private ForcedPackagesGrid _forcedPackagesGrid = new();
    private List<ForcedPackageItem> _forcedPackages = new();
    
    protected override void OnInitialized()
    {
        Get();
        base.OnInitialized();
    }

    private void Update()
    {
        _modulesSettings.List = _modulesGrid.ModuleSettings;
        _modulesSettings.Domains = _domains;
        _modulesSettings.NugetServers = _nugetServersGrid.NugetServersSettings;
        _modulesSettings.NugetFolders = _nugetFoldersGrid.NugetFolderSettings;
        _modulesSettings.FrameworkPriorities = _frameworkPrioritiesGrid.FrameworkPriorities;
        _modulesSettings.ForcedPackages = _forcedPackagesGrid.ForcedPackages;
        Context.Update<ModulesSettings>(_modulesSettings);
    }

    private void Get()
    {
        _modulesSettings = Context.Get<ModulesSettings>() ?? new ModulesSettings();
        _modules = _modulesSettings.List;
        _domains = _modulesSettings.Domains;
        _nugetServers = _modulesSettings.NugetServers;
        _nugetFolders = _modulesSettings.NugetFolders;
        _frameworkPriorities = _modulesSettings.FrameworkPriorities;
        _forcedPackages = _modulesSettings.ForcedPackages;
    }


}