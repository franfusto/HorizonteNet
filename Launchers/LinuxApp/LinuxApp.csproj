<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>false</PublishAot>
        
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsPackable>false</IsPackable>
    </PropertyGroup>


    <ItemGroup>
        <Content Include="bin\Debug\net10.0\cache_commands.csv"/>
        <Content Include="bin\Debug\net10.0\horizonte.json"/>
        <Content Include="bin\Debug\net10.0\horizonte_backup.json"/>
    </ItemGroup>
    
    <ItemGroup>
        <Content Remove="horizonte.default.json"/>
        <EmbeddedResource Include="horizonte.default.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\..\Horizonte\Horizonte.csproj"/>
    </ItemGroup>


</Project>
