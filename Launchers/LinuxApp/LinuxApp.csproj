<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>false</PublishAot>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>

       
        <ProjectReference Include="..\..\Horizonte.Extension.AspNetCore\Horizonte.Extension.AspNetCore.csproj" />
        
        
        <ProjectReference Include="..\..\Horizonte\Horizonte.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <Content Remove="horizonte.default.json" />
      <Content Include="bin\Debug\net10.0\horizonte.json" />
      <EmbeddedResource Include="horizonte.default.json">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>


