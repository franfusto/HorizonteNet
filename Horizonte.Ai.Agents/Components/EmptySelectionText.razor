<RadzenAlert Severity="AlertSeverity.Info"
             Variant="Variant.Outlined"
             Style="margin-top: 0.5rem;">
    @Text
</RadzenAlert>

@code {
    /// <summary>
    /// Texto descriptivo que se muestra cuando no hay ningún elemento seleccionado en el panel.
    /// </summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;
}