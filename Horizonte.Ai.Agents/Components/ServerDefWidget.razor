@using Horizonte.Extension.Ai.Definitions

@if (Model is null)
{
    <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Outlined">
        No hay ningún servidor seleccionado.
    </RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        <RadzenFieldset Text="Servidor">
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Id" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Id"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nombre" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Name"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Url" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Url"
                                           Placeholder="https://..."
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Provider" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Provider"
                                           Placeholder="openai, azure, ollama..."
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Api Version" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.ApiVersion"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Api Key" Style="width: 100%">
                            <RadzenPassword @bind-Value="Model.ApiKey"
                                            Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Timeout segundos" Style="width: 100%">
                            <RadzenNumeric @bind-Value="Model.TimeoutSeconds"
                                           Min="1"
                                           Max="3600"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Headers">
            <RadzenStack Gap="0.75rem">
                <RadzenButton Text="Añadir header"
                              Icon="add"
                              Size="ButtonSize.Small"
                              Variant="Variant.Outlined"
                              Click="AddHeader" />

                @if (_headerRows.Count == 0)
                {
                    <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                        No hay headers configurados.
                    </RadzenAlert>
                }
                else
                {
                    @foreach (var row in _headerRows)
                    {
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="5">
                                <RadzenTextBox @bind-Value="row.Key"
                                               Change="@(_ => SyncHeaders())"
                                               Placeholder="Header"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenTextBox @bind-Value="row.Value"
                                               Change="@(_ => SyncHeaders())"
                                               Placeholder="Valor"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="1">
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveHeader(row))" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                }
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Settings">
            <RadzenStack Gap="0.75rem">
                <RadzenButton Text="Añadir setting"
                              Icon="add"
                              Size="ButtonSize.Small"
                              Variant="Variant.Outlined"
                              Click="AddSetting" />

                @if (_settingRows.Count == 0)
                {
                    <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                        No hay settings configurados.
                    </RadzenAlert>
                }
                else
                {
                    @foreach (var row in _settingRows)
                    {
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="5">
                                <RadzenTextBox @bind-Value="row.Key"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Clave"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenTextBox @bind-Value="row.Value"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Valor"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="1">
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveSetting(row))" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                }
            </RadzenStack>
        </RadzenFieldset>
    </RadzenStack>
}

@code {
    [Parameter]
    public ServerDef? Model { get; set; }

    private readonly List<DictionaryRow> _headerRows = [];
    private readonly List<DictionaryRow> _settingRows = [];

    protected override void OnParametersSet()
    {
        LoadRows();
    }

    private void LoadRows()
    {
        _headerRows.Clear();
        _settingRows.Clear();

        if (Model is null)
        {
            return;
        }

        Model.Headers ??= [];
        Model.Settings ??= [];

        _headerRows.AddRange(
            Model.Headers.Select(item => new DictionaryRow
            {
                Key = item.Key,
                Value = item.Value
            }));

        _settingRows.AddRange(
            Model.Settings.Select(item => new DictionaryRow
            {
                Key = item.Key,
                Value = item.Value
            }));
    }

    private void AddHeader()
    {
        _headerRows.Add(new DictionaryRow
        {
            Key = string.Empty,
            Value = string.Empty
        });

        SyncHeaders();
    }

    private void RemoveHeader(DictionaryRow row)
    {
        _headerRows.Remove(row);

        SyncHeaders();
    }

    private void SyncHeaders()
    {
        if (Model is null)
        {
            return;
        }

        Model.Headers = ToDictionary(_headerRows);
    }

    private void AddSetting()
    {
        _settingRows.Add(new DictionaryRow
        {
            Key = string.Empty,
            Value = string.Empty
        });

        SyncSettings();
    }

    private void RemoveSetting(DictionaryRow row)
    {
        _settingRows.Remove(row);

        SyncSettings();
    }

    private void SyncSettings()
    {
        if (Model is null)
        {
            return;
        }

        Model.Settings = ToDictionary(_settingRows);
    }

    private static Dictionary<string, string> ToDictionary(IEnumerable<DictionaryRow> rows)
    {
        return rows
            .Where(row => !string.IsNullOrWhiteSpace(row.Key))
            .GroupBy(row => row.Key.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.Last().Value ?? string.Empty,
                StringComparer.OrdinalIgnoreCase);
    }

    private sealed class DictionaryRow
    {
        public string Key { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;
    }
}