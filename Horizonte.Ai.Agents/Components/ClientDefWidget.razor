@using Horizonte.Extension.Ai.Definitions

@if (Model is null)
{
    <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Outlined">
        No hay ningún cliente seleccionado.
    </RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        <RadzenFieldset Text="Cliente">
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Id" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Id"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nombre" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Name"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Tipo de cliente" Style="width: 100%">
                            <RadzenDropDown TValue="ClientType"
                                            Data="@ClientTypes"
                                            @bind-Value="Model.ClientType"
                                            Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Servidor" Style="width: 100%">
                            @if (ServerOptions.Count == 0)
                            {
                                <RadzenTextBox @bind-Value="Model.Server"
                                               Placeholder="Id del servidor"
                                               Style="width: 100%" />
                            }
                            else
                            {
                                <RadzenDropDown TValue="string"
                                                Data="@ServerOptions"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                @bind-Value="Model.Server"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Selecciona un servidor"
                                                Style="width: 100%" />
                            }
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Modelo" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Model"
                                           Placeholder="gpt-4.1, llama3.1, ..."
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Temperature" Style="width: 100%">
                            <RadzenNumeric TValue="float?"
                                           @bind-Value="Model.Temperature"
                                           Min="0"
                                           Max="2"
                                           Step="0.1"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Max output tokens" Style="width: 100%">
                            <RadzenNumeric TValue="int?"
                                           @bind-Value="Model.MaxOutputTokens"
                                           Min="1"
                                           Max="1000000"
                                           Step="1"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.5rem">
                            <RadzenCheckBox TValue="bool"
                                            @bind-Value="Model.EnableStreaming"
                                            Name="enableStreaming" />
                            <RadzenLabel Text="Streaming habilitado"
                                         Component="enableStreaming" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.5rem">
                            <RadzenCheckBox TValue="bool"
                                            @bind-Value="Model.EnableTools"
                                            Name="enableTools" />
                            <RadzenLabel Text="Tools habilitadas"
                                         Component="enableTools" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Settings">
            <RadzenStack Gap="0.75rem">
                <RadzenButton Text="Añadir setting"
                              Icon="add"
                              Size="ButtonSize.Small"
                              Variant="Variant.Outlined"
                              Click="AddSetting" />

                @if (_settingRows.Count == 0)
                {
                    <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                        No hay settings configurados.
                    </RadzenAlert>
                }
                else
                {
                    @foreach (var row in _settingRows)
                    {
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="5">
                                <RadzenTextBox @bind-Value="row.Key"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Clave"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenTextBox @bind-Value="row.Value"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Valor"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="1">
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveSetting(row))" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                }
            </RadzenStack>
        </RadzenFieldset>
    </RadzenStack>
}

@code {
    [Parameter]
    public ClientDef? Model { get; set; }

    [Parameter]
    public ServerDef[] ServerDefs { get; set; } = [];

    private ClientDef? _loadedModel;

    private readonly List<DictionaryRow> _settingRows = [];

    private static ClientType[] ClientTypes =>
        Enum.GetValues<ClientType>();

    private List<ServerOption> ServerOptions =>
        ServerDefs
            .Select(server => new ServerOption
            {
                Id = server.Id,
                Name = string.IsNullOrWhiteSpace(server.Name)
                    ? server.Id
                    : $"{server.Name} ({server.Id})"
            })
            .Where(server => !string.IsNullOrWhiteSpace(server.Id))
            .ToList();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedModel, Model))
        {
            LoadRows();
            _loadedModel = Model;
        }
    }

    private void LoadRows()
    {
        _settingRows.Clear();

        if (Model is null)
        {
            return;
        }

        Model.Settings ??= [];

        _settingRows.AddRange(
            Model.Settings.Select(item => new DictionaryRow
            {
                Key = item.Key,
                Value = item.Value
            }));
    }

    private void AddSetting()
    {
        _settingRows.Add(new DictionaryRow
        {
            Key = string.Empty,
            Value = string.Empty
        });

        SyncSettings();
    }

    private void RemoveSetting(DictionaryRow row)
    {
        _settingRows.Remove(row);

        SyncSettings();
    }

    private void SyncSettings()
    {
        if (Model is null)
        {
            return;
        }

        Model.Settings = ToDictionary(_settingRows);
    }

    private static Dictionary<string, string> ToDictionary(IEnumerable<DictionaryRow> rows)
    {
        return rows
            .Where(row => !string.IsNullOrWhiteSpace(row.Key))
            .GroupBy(row => row.Key.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.Last().Value ?? string.Empty,
                StringComparer.OrdinalIgnoreCase);
    }

    private sealed class DictionaryRow
    {
        public string Key { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;
    }

    private sealed class ServerOption
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
    }
}