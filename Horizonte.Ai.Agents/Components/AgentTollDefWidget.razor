@using Horizonte.Extension.Ai.Definitions

@if (Model is null)
{
    <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Outlined">
        No hay ninguna tool seleccionada.
    </RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        <RadzenFieldset Text="Tool">
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Id" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Id"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nombre" Style="width: 100%">
                            <RadzenTextBox @bind-Value="Model.Name"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Tipo de tool" Style="width: 100%">
                            <RadzenDropDown TValue="AgentToolType"
                                            Data="@ToolTypes"
                                            @bind-Value="Model.ToolType"
                                            Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Timeout segundos" Style="width: 100%">
                            <RadzenNumeric TValue="int"
                                           @bind-Value="Model.TimeoutSeconds"
                                           Min="1"
                                           Max="3600"
                                           Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.5rem"
                                     Style="height: 100%; padding-top: 1.75rem;">
                            <RadzenCheckBox TValue="bool"
                                            @bind-Value="Model.Enabled"
                                            Name="toolEnabled" />
                            <RadzenLabel Text="Habilitada"
                                         Component="toolEnabled" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Cliente" Style="width: 100%">
                            @if (ClientOptions.Count == 0)
                            {
                                <RadzenTextBox @bind-Value="Model.ClientId"
                                               Placeholder="Id del cliente"
                                               Style="width: 100%" />
                            }
                            else
                            {
                                <RadzenDropDown TValue="string"
                                                Data="@ClientOptions"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                @bind-Value="Model.ClientId"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Selecciona un cliente"
                                                Style="width: 100%" />
                            }
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="RAG" Style="width: 100%">
                            @if (RagOptions.Count == 0)
                            {
                                <RadzenTextBox @bind-Value="Model.RagId"
                                               Placeholder="Id de la configuración RAG"
                                               Style="width: 100%" />
                            }
                            else
                            {
                                <RadzenDropDown TValue="string"
                                                Data="@RagOptions"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                @bind-Value="Model.RagId"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Selecciona una configuración RAG"
                                                Style="width: 100%" />
                            }
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Settings">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenButton Text="Añadir setting"
                                  Icon="add"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Outlined"
                                  Click="AddSetting" />

                    <RadzenButton Text="Plantilla custom"
                                  Icon="auto_fix_high"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Outlined"
                                  Click="ApplyCustomTemplate" />
                </RadzenStack>

                @if (_settingRows.Count == 0)
                {
                    <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Outlined">
                        No hay settings configurados.
                    </RadzenAlert>
                }
                else
                {
                    @foreach (var row in _settingRows)
                    {
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="5">
                                <RadzenTextBox @bind-Value="row.Key"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Clave"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenTextBox @bind-Value="row.Value"
                                               Change="@(_ => SyncSettings())"
                                               Placeholder="Valor"
                                               Style="width: 100%" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="1">
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveSetting(row))" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                }
            </RadzenStack>
        </RadzenFieldset>
    </RadzenStack>
}

@code {
    [Parameter]
    public AgentToolDef? Model { get; set; }

    [Parameter]
    public ClientDef[] ClientDefs { get; set; } = [];

    [Parameter]
    public RaGdef[] RagDefs { get; set; } = [];

    private AgentToolDef? _loadedModel;

    private readonly List<DictionaryRow> _settingRows = [];

    private static AgentToolType[] ToolTypes =>
        Enum.GetValues<AgentToolType>();

    private List<SelectOption> ClientOptions =>
        ClientDefs
            .Select(client => new SelectOption
            {
                Id = client.Id,
                Name = string.IsNullOrWhiteSpace(client.Name)
                    ? client.Id
                    : $"{client.Name} ({client.Id})"
            })
            .Where(client => !string.IsNullOrWhiteSpace(client.Id))
            .ToList();

    private List<SelectOption> RagOptions =>
        RagDefs
            .Select(rag => new SelectOption
            {
                Id = rag.Id,
                Name = string.IsNullOrWhiteSpace(rag.Name)
                    ? rag.Id
                    : $"{rag.Name} ({rag.Id})"
            })
            .Where(rag => !string.IsNullOrWhiteSpace(rag.Id))
            .ToList();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedModel, Model))
        {
            LoadRows();
            _loadedModel = Model;
        }
    }

    private void LoadRows()
    {
        _settingRows.Clear();

        if (Model is null)
        {
            return;
        }

        Model.Settings ??= [];

        _settingRows.AddRange(
            Model.Settings.Select(item => new DictionaryRow
            {
                Key = item.Key,
                Value = item.Value
            }));
    }

    private void AddSetting()
    {
        _settingRows.Add(new DictionaryRow
        {
            Key = string.Empty,
            Value = string.Empty
        });

        SyncSettings();
    }

    private void RemoveSetting(DictionaryRow row)
    {
        _settingRows.Remove(row);

        SyncSettings();
    }

    private void ApplyCustomTemplate()
    {
        SetSetting("action", "echo");
        SetSetting("autoUse", "false");
        SetSetting("template", "{{query}}");

        SyncSettings();
    }

    private void SetSetting(string key, string value)
    {
        var row = _settingRows.FirstOrDefault(item =>
            string.Equals(item.Key, key, StringComparison.OrdinalIgnoreCase));

        if (row is null)
        {
            _settingRows.Add(new DictionaryRow
            {
                Key = key,
                Value = value
            });

            return;
        }

        row.Value = value;
    }

    private void SyncSettings()
    {
        if (Model is null)
        {
            return;
        }

        Model.Settings = ToDictionary(_settingRows);
    }

    private static Dictionary<string, string> ToDictionary(IEnumerable<DictionaryRow> rows)
    {
        return rows
            .Where(row => !string.IsNullOrWhiteSpace(row.Key))
            .GroupBy(row => row.Key.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.Last().Value ?? string.Empty,
                StringComparer.OrdinalIgnoreCase);
    }

    private sealed class DictionaryRow
    {
        public string Key { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;
    }

    private sealed class SelectOption
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
    }
}